  "lessons": [
    {
      "id": "draft.n5_01.lesson.v",
      "planning_key": "N5-01-L01",
      "type": "V",
      "title": "初见时选择词语",
      "prerequisites": [
        "S0-03"
      ],
      "goals": [
        {
          "id": "draft.n5_01.goal.v1",
          "text": "根据时段和关系选用问候与初见收尾。"
        },
        {
          "id": "draft.n5_01.goal.v2",
          "text": "区分姓名、身份和国籍的基本表达。"
        }
      ],
      "word_refs": [
        "draft.n5_01.word.greet",
        "draft.n5_01.word.meeting",
        "draft.n5_01.word.thanks",
        "draft.n5_01.word.person",
        "draft.n5_01.word.name",
        "draft.n5_01.word.identity",
        "draft.n5_01.word.nationality",
        "draft.n5_01.word.reply"
      ],
      "explanation_zh": "初次与陌生人见面，先按时段问候，再说はじめまして；最后用よろしくおねがいします。おはようございます用于早上，こんにちは用于白天，こんばんは用于晚上。さん跟对方姓名，不加在自己的姓名后。国籍与职业是不同信息；不愿透露时不应强求。お名前是问对方名字的礼貌形式；名字中的音和片假名以本人习惯为准。",
      "materials": [
        {
          "id": "draft.n5_01.mat.v.teach",
          "role": "teach",
          "jp": "こんばんは。はじめまして。わたしは さとうです。よろしくおねがいします。",
          "kana": "こんばんは。はじめまして。わたしは さとうです。よろしくおねがいします。",
          "zh": "晚上好。初次见面。我是佐藤。请多关照。"
        },
        {
          "id": "draft.n5_01.mat.v.practice",
          "role": "practice",
          "jp": "朝、初めて会います。",
          "kana": "あさ、はじめて あいます。",
          "zh": "早晨初次见面。"
        },
        {
          "id": "draft.n5_01.mat.v.check",
          "role": "check",
          "jp": "夜、初めて会います。",
          "kana": "よる、はじめて あいます。",
          "zh": "晚上初次见面。"
        }
      ],
      "practice": [
        {
          "id": "draft.n5_01.q.v.p1",
          "material_ref": "draft.n5_01.mat.v.practice",
          "goal_ref": "draft.n5_01.goal.v1",
          "word_refs": [
            "draft.n5_01.word.greet"
          ],
          "prompt": "早晨礼貌问候选哪一项？",
          "choices": [
            "おはようございます",
            "こんばんは"
          ],
          "answer": "おはようございます",
          "feedback": "おはようございます用于早晨；こんばんは用于晚上。"
        },
        {
          "id": "draft.n5_01.q.v.p2",
          "material_ref": "draft.n5_01.mat.v.practice",
          "goal_ref": "draft.n5_01.goal.v2",
          "word_refs": [
            "draft.n5_01.word.identity",
            "draft.n5_01.word.nationality"
          ],
          "prompt": "哪一项表示身份而非国籍？",
          "choices": [
            "がくせい",
            "にほんじん"
          ],
          "answer": "がくせい",
          "feedback": "がくせい是学生；にほんじん说的是国籍。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_01.q.v.c1",
          "material_ref": "draft.n5_01.mat.v.check",
          "goal_ref": "draft.n5_01.goal.v1",
          "word_refs": [
            "draft.n5_01.word.greet"
          ],
          "prompt": "晚上礼貌问候选哪一项？",
          "choices": [
            "こんばんは",
            "おはようございます"
          ],
          "answer": "こんばんは",
          "feedback": "こんばんは适合晚上；おはようございます是早晨问候。"
        },
        {
          "id": "draft.n5_01.q.v.c2",
          "material_ref": "draft.n5_01.mat.v.check",
          "goal_ref": "draft.n5_01.goal.v2",
          "word_refs": [
            "draft.n5_01.word.person"
          ],
          "prompt": "介绍自己为佐藤时，哪个说法合适？",
          "choices": [
            "さとうです",
            "さとうさんです"
          ],
          "answer": "さとうです",
          "feedback": "介绍自己的姓名不加さん；さん用于称呼别人。"
        }
      ],
      "review_zh": "隔天看场景重选时段问候；错在职业/国籍时把两类词分栏，再用新名字自述。"
    },
    {
      "id": "draft.n5_01.lesson.g",
      "planning_key": "N5-01-L02",
      "type": "G",
      "title": "礼貌介绍与提问结构",
      "prerequisites": [
        "draft.n5_01.lesson.v"
      ],
      "goals": [
        {
          "id": "draft.n5_01.goal.g1",
          "text": "用は和です组成姓名、身份或国籍陈述。"
        },
        {
          "id": "draft.n5_01.goal.g2",
          "text": "用か提问并用の连接所属或关联。"
        }
      ],
      "word_refs": [
        "draft.n5_01.word.structure",
        "draft.n5_01.word.person",
        "draft.n5_01.word.name",
        "draft.n5_01.word.identity",
        "draft.n5_01.word.nationality",
        "draft.n5_01.word.institution",
        "draft.n5_01.word.reply"
      ],
      "explanation_zh": "AはBです：A是话题，B是介绍内容；助词は在此读作わ，不把它改写为わ。话题已清楚时可省略。句末加か构成礼貌问句，问姓名常说お名前は何ですか；问国籍可说何人ですか。是非问题用はい／いいえ，何问题用具体信息回答。AのB连接名词：大学の学生是与大学有关的学生；不要理解成所有の都只表示所有权。称呼对方可用姓名＋さん，通常不必反复使用あなた。",
      "common_mistake_zh": "「わたしは」里的「は」念作「わ」，写时仍用「は」。问对方是不是学生时，在「学生です」后加「か」。",
      "materials": [
        {
          "id": "draft.n5_01.mat.g.teach",
          "role": "teach",
          "jp": "わたしは 大学の学生です。お名前は何ですか。",
          "kana": "わたしは だいがくの がくせいです。おなまえは なんですか。",
          "zh": "我是大学的学生。您叫什么名字？"
        },
        {
          "id": "draft.n5_01.mat.g.practice",
          "role": "practice",
          "jp": "わたし＿会社員です。",
          "kana": "わたし＿かいしゃいんです。",
          "zh": "我是公司职员。"
        },
        {
          "id": "draft.n5_01.mat.g.check",
          "role": "check",
          "jp": "大学＿学生です。",
          "kana": "だいがく＿がくせいです。",
          "zh": "是大学的学生。"
        }
      ],
      "practice": [
        {
          "id": "draft.n5_01.q.g.p1",
          "material_ref": "draft.n5_01.mat.g.practice",
          "goal_ref": "draft.n5_01.goal.g1",
          "word_refs": [
            "draft.n5_01.word.structure"
          ],
          "prompt": "填话题助词。",
          "choices": [
            "は",
            "の"
          ],
          "answer": "は",
          "feedback": "わたしは引出话题；の连接名词，不在此处标记话题。"
        },
        {
          "id": "draft.n5_01.q.g.p2",
          "material_ref": "draft.n5_01.mat.g.practice",
          "goal_ref": "draft.n5_01.goal.g2",
          "word_refs": [
            "draft.n5_01.word.structure",
            "draft.n5_01.word.name"
          ],
          "prompt": "问名字的句尾选哪一项？ お名前は何です＿",
          "choices": [
            "か",
            "の"
          ],
          "answer": "か",
          "feedback": "句末か构成疑问；の不是这里的礼貌疑问句尾。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_01.q.g.c1",
          "material_ref": "draft.n5_01.mat.g.check",
          "goal_ref": "draft.n5_01.goal.g2",
          "word_refs": [
            "draft.n5_01.word.structure",
            "draft.n5_01.word.institution"
          ],
          "prompt": "连接大学与学生应填什么？",
          "choices": [
            "の",
            "か"
          ],
          "answer": "の",
          "feedback": "大学の学生用の连接两个名词；か用于疑问句尾。"
        },
        {
          "id": "draft.n5_01.q.g.c2",
          "material_ref": "draft.n5_01.mat.g.check",
          "goal_ref": "draft.n5_01.goal.g1",
          "word_refs": [
            "draft.n5_01.word.structure",
            "draft.n5_01.word.nationality"
          ],
          "prompt": "选择礼貌介绍国籍的完整句。",
          "choices": [
            "わたしは 中国人です。",
            "わたしの 中国人か。"
          ],
          "answer": "わたしは 中国人です。",
          "feedback": "は引出话题，です作礼貌断定；另一项的の和か不构成所需陈述。"
        }
      ],
      "review_zh": "将话题、内容、句尾分色；错题改换人名再写，隔天对照は的读音与写法。"
    },
    {
      "id": "draft.n5_01.lesson.r",
      "planning_key": "N5-01-L03",
      "type": "R",
      "title": "从名片提取信息",
      "prerequisites": [
        "draft.n5_01.lesson.g"
      ],
      "goals": [
        {
          "id": "draft.n5_01.goal.r1",
          "text": "借助假名识别名片姓名、身份、国籍和所属。"
