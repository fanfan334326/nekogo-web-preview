          ],
          "answer": "すずき",
          "feedback": "名前后是すずき；さとう不在这张卡上。"
        },
        {
          "id": "draft.n5_01.q.r.c2",
          "material_ref": "draft.n5_01.mat.r.check",
          "goal_ref": "draft.n5_01.goal.r1",
          "word_refs": [
