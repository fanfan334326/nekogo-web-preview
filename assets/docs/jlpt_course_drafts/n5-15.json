            "draft.n5_15.word.2",
            "draft.n5_15.word.3",
            "draft.n5_15.word.4",
            "draft.n5_15.word.5",
            "draft.n5_15.word.6"
          ],
          "prompt": "昨天去公园了吗？",
          "choices": [
            "去了",
            "没去",
            "句子没有交代"
          ],
          "answer": "没去",
          "feedback": "「行きませんでした」说明没去。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_15.lesson.g.check.q1",
          "material_ref": "draft.n5_15.lesson.g.check",
          "goal_ref": "draft.n5_15.lesson.g.goal",
          "word_refs": [
            "draft.n5_15.word.1",
