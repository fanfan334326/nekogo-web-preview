    {
      "id": "draft.n5_15.lesson.g",
      "planning_key": "N5-15-L02",
      "type": "G",
      "title": "用过去式说做过和没做过的事",
      "prerequisites": [
        "N5-15-L01"
      ],
      "goals": [
        {
          "id": "draft.n5_15.lesson.g.goal",
          "text": "用过去式说做过和没做过的事"
        }
      ],
      "word_refs": [
        "draft.n5_15.word.1",
        "draft.n5_15.word.2",
        "draft.n5_15.word.3",
        "draft.n5_15.word.4",
        "draft.n5_15.word.5",
        "draft.n5_15.word.6"
      ],
      "explanation_zh": "「見ました」表示看了，「見ませんでした」表示没看。说过去的感受时，「楽しいです」变成「楽しかったです」。",
      "common_mistake_zh": "「見ません」表示现在或将来不看，说昨天没看要用「見ませんでした」。「楽しかったです」已经表示过去，不说「楽しかったでした」。",
      "materials": [
        {
          "id": "draft.n5_15.lesson.g.teach",
          "role": "teach",
          "jp": "昨日は公園へ行きました。映画は見ませんでした。公園は楽しかったです。",
          "goal_refs": [
            "draft.n5_15.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_15.lesson.g.practice",
          "role": "practice",
          "jp": "昨日は雨でした。公園へ行きませんでした。",
          "goal_refs": [
            "draft.n5_15.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_15.lesson.g.check",
          "role": "check",
          "jp": "先週の旅行は〔　〕。",
          "goal_refs": [
            "draft.n5_15.lesson.g.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_15.lesson.g.practice.q1",
          "material_ref": "draft.n5_15.lesson.g.practice",
