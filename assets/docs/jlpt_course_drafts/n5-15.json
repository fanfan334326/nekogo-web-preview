  "lessons": [
    {
      "id": "draft.n5_15.lesson.v",
      "planning_key": "N5-15-L01",
      "type": "V",
      "title": "认出过去的时间和活动",
      "prerequisites": [
        "N5-14"
      ],
      "goals": [
        {
          "id": "draft.n5_15.lesson.v.goal",
          "text": "认出过去的时间和活动"
        }
      ],
      "word_refs": [
        "draft.n5_15.word.1",
        "draft.n5_15.word.2",
        "draft.n5_15.word.3",
        "draft.n5_15.word.4",
        "draft.n5_15.word.5",
        "draft.n5_15.word.6"
      ],
      "explanation_zh": "「昨日」是昨天，「先週」是上周。读完时间，再看那天做了什么。京都（きょうと）是本课的旅行地点；「おみやげ」表示旅行带回的礼物或纪念品。",
      "materials": [
        {
          "id": "draft.n5_15.lesson.v.teach",
          "role": "teach",
          "jp": "先週、京都へ旅行に行きました。",
          "goal_refs": [
            "draft.n5_15.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n5_15.lesson.v.practice",
          "role": "practice",
          "jp": "昨日、映画を見ました。",
          "goal_refs": [
            "draft.n5_15.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n5_15.lesson.v.check",
          "role": "check",
          "jp": "先週、駅でおみやげを買いました。",
          "goal_refs": [
            "draft.n5_15.lesson.v.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_15.lesson.v.practice.q1",
