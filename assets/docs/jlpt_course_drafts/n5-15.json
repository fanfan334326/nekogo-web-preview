            "draft.n5_15.word.6"
          ],
          "prompt": "什么时候看了电影？",
          "choices": [
            "上周",
            "昨天",
            "今天"
          ],
          "answer": "昨天",
          "feedback": "「昨日」指昨天。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_15.lesson.v.check.q1",
          "material_ref": "draft.n5_15.lesson.v.check",
          "goal_ref": "draft.n5_15.lesson.v.goal",
