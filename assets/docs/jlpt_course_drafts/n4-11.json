            "draft.n4_11.word.4"
          ],
          "prompt": "住客请求什么？",
          "choices": [
            "多拿一条毯子",
            "延后退房",
            "帮忙看看房门为什么打不开"
          ],
          "answer": "帮忙看看房门为什么打不开",
          "feedback": "「部屋のドアが開かない」说明房门打不开，「見てもらえますか」是请对方帮忙查看。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_11.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_11.lesson.g.mat.check",
