      ],
      "word_refs": [
        "draft.n4_11.word.1",
        "draft.n4_11.word.2",
        "draft.n4_11.word.3",
        "draft.n4_11.word.4"
      ],
      "explanation_zh": "「〜んですが」说明请求的背景，后面接具体请求。「〜てもらえますか」礼貌询问能否请对方帮忙。",
      "materials": [
        {
          "id": "draft.n4_11.lesson.g.mat.teach",
          "role": "teach",
          "jp": "部屋が少し寒いんですが、毛布を持ってきてもらえますか。"
        },
        {
          "id": "draft.n4_11.lesson.g.mat.practice",
          "role": "practice",
          "jp": "部屋のドアが開かないんですが、見てもらえますか。"
        },
        {
          "id": "draft.n4_11.lesson.g.mat.check",
          "role": "check",
          "jp": "タオルが一枚足りないんですが、もう一枚持ってきて＿か。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_11.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_11.lesson.g.mat.practice",
