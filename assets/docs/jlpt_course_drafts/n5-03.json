      "prerequisite_status": "recommended_not_verified",
      "goals": [
        {
          "id": "draft.n5_03.goal.g",
          "text": "能区分何時和何日，用に标具体时间、から/まで标范围。"
        }
      ],
      "word_refs": [
        "draft.n5_03.word.date",
        "draft.n5_03.word.hour",
        "draft.n5_03.word.minute",
        "draft.n5_03.word.grammar",
        "draft.n5_03.word.actions",
        "draft.n5_03.word.context"
      ],
      "explanation_zh": "何時ですか问几点，何日ですか问几号；回答按语境说日期或时刻。具体时刻后に标动作发生点，如三時に会います；起点から、终点まで，合起来表示从……到……。星期后に可以出现，本稿以具体时刻为例，不推导所有时间词的用法。会います是见面，始まります是开始，終わります是结束；下例均为礼貌句。",
      "common_mistake_zh": "「三時に会います」是三点见面；「三時から」表示从三点开始。问时刻用「何時」，问日期用「何日」。",
      "materials": [
        {
          "id": "draft.n5_03.mat.gt",
          "role": "teach",
          "jp": "会うのは何日ですか。五月五日です。何時に会いますか。二時に会います。",
          "kana": "あうのはなんにちですか。ごがついつかです。なんじにあいますか。にじにあいます。",
          "zh": "哪一天见面？五月五日。几点见面？两点见面。",
          "goal_refs": [
