    {
      "id": "draft.n4_13.lesson.g",
      "planning_key": "N4-13-L02",
      "type": "G",
      "title": "〜つもりです・〜予定です",
      "prerequisites": [
        "N4-13-L01"
      ],
      "goals": [
        {
          "id": "draft.n4_13.lesson.g.goal",
          "text": "〜つもりです・〜予定です"
        }
      ],
      "word_refs": [
        "draft.n4_13.word.1",
        "draft.n4_13.word.2",
        "draft.n4_13.word.3",
        "draft.n4_13.word.4"
      ],
      "explanation_zh": "「つもり」表达个人打算；「予定」常表达已列进安排的事项。两者都能接动词原形。",
      "materials": [
        {
          "id": "draft.n4_13.lesson.g.mat.teach",
          "role": "teach",
          "jp": "毎日十分練習するつもりです。発表は来週の予定です。"
        },
        {
          "id": "draft.n4_13.lesson.g.mat.practice",
          "role": "practice",
          "jp": "来月から早起きするつもりです。"
        },
        {
          "id": "draft.n4_13.lesson.g.mat.check",
          "role": "check",
          "jp": "夏休みに毎日一ページ読む＿です。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_13.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_13.lesson.g.mat.practice",
          "goal_ref": "draft.n4_13.lesson.g.goal",
          "word_refs": [
            "draft.n4_13.word.1",
            "draft.n4_13.word.2",
            "draft.n4_13.word.3",
            "draft.n4_13.word.4"
          ],
          "prompt": "说话人有什么打算？",
          "choices": [
            "下月起早起",
            "今晚早睡",
            "下周发表"
          ],
          "answer": "下月起早起",
          "feedback": "正确答案是「下月起早起」。原句：来月から早起きするつもりです。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_13.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_13.lesson.g.mat.check",
          "goal_ref": "draft.n4_13.lesson.g.goal",
          "word_refs": [
            "draft.n4_13.word.1",
            "draft.n4_13.word.2",
            "draft.n4_13.word.3",
            "draft.n4_13.word.4"
          ],
          "prompt": "哪项表达个人打算？",
          "choices": [
            "まで",
            "ながら",
            "つもり"
          ],
          "answer": "つもり",
          "feedback": "正确答案是「つもり」。原文：夏休みに毎日一ページ読む＿です。"
        }
      ],
      "common_mistake_zh": "「読むつもりです」说明个人打算。「来週の予定です」说明已列进日程的时间。单凭「予定」不能推断说话者本人愿意做。"
    },
    {
