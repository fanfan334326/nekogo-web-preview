    {
      "id": "draft.n4_08.lesson.g",
      "planning_key": "N4-08-L02",
      "type": "G",
      "title": "〜から・〜が続いています",
      "prerequisites": [
        "N4-08-L01"
      ],
      "goals": [
        {
          "id": "draft.n4_08.lesson.g.goal",
          "text": "〜から・〜が続いています"
        }
      ],
      "word_refs": [
        "draft.n4_08.word.1",
        "draft.n4_08.word.2",
        "draft.n4_08.word.3",
        "draft.n4_08.word.4"
      ],
      "explanation_zh": "「时间＋から」说明症状从什么时候开始。「症状＋が続いています」说明症状一直没消失，例如「せきが続いています」表示一直咳嗽。这里的「続いています」来自「続く」，说明症状还在持续；不要与「勉強を続けています」中的「続ける」混淆。",
      "materials": [
        {
          "id": "draft.n4_08.lesson.g.mat.teach",
          "role": "teach",
          "jp": "三日前からせきが続いています。"
        },
        {
          "id": "draft.n4_08.lesson.g.mat.practice",
          "role": "practice",
          "jp": "昨日の夜から頭が痛いです。"
        },
        {
          "id": "draft.n4_08.lesson.g.mat.check",
          "role": "check",
          "jp": "火曜日の朝＿、せきが続いています。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_08.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_08.lesson.g.mat.practice",
          "goal_ref": "draft.n4_08.lesson.g.goal",
          "word_refs": [
            "draft.n4_08.word.1",
            "draft.n4_08.word.2",
            "draft.n4_08.word.3",
            "draft.n4_08.word.4"
          ],
          "prompt": "头痛从何时开始？",
          "choices": [
            "今天早上",
            "三天前",
            "昨晚"
          ],
          "answer": "昨晚",
          "feedback": "正确答案是「昨晚」。原句：昨日の夜から頭が痛いです。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_08.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_08.lesson.g.mat.check",
          "goal_ref": "draft.n4_08.lesson.g.goal",
          "word_refs": [
            "draft.n4_08.word.1",
            "draft.n4_08.word.2",
            "draft.n4_08.word.3",
            "draft.n4_08.word.4"
          ],
          "prompt": "哪个词标记症状的起点？",
          "choices": [
            "だけ",
            "から",
            "まで"
          ],
          "answer": "から",
          "feedback": "正确答案是「から」。原文：火曜日の朝＿、せきが続いています。"
        }
      ],
      "common_mistake_zh": "「火曜日の朝から」给出开始时间；「火曜日の朝まで」给出结束时间。症状还在持续时用「から」说明起点。描述症状持续用「せきが続いています」；「続く」的て形是「続いて」，不是「続けて」。"
    },
