  "lessons": [
    {
      "id": "draft.n5_04.lesson.v",
      "planning_key": "N5-04-L01",
      "type": "V",
      "title": "学校用品与场所",
      "prerequisites": [
        "N5-03"
      ],
      "prerequisite_status": "recommended_not_verified",
      "goals": [
        {
          "id": "draft.n5_04.goal.v",
          "text": "根据假名语境辨认学校、教室、书、笔、桌子和老师。"
        }
      ],
      "word_refs": [
        "draft.n5_04.word.places",
        "draft.n5_04.word.objects",
        "draft.n5_04.word.people",
        "draft.n5_04.word.pointer",
        "draft.n5_04.word.grammar",
        "draft.n5_04.word.schedule",
        "draft.n5_04.word.subjects"
      ],
      "explanation_zh": "先诊断假名、N5-03 时间和礼貌句，不假定已掌握。学校がっこう是学校，教室きょうしつ是教室；本ほん书、ペン笔、机つくえ桌子或课桌、先生せんせい老师、学生がくせい学生。不要把本、ペン、机当成同一种用品。学生在此读がくせい；先与生合写先生せんせい。は作主题标记读わ，です作礼貌判断；これ独立指说话人手边的物品，完整指示词对照在G课。科目与时间词见词表，供后续课程表复习，不视为已掌握。",
      "materials": [
        {
          "id": "draft.n5_04.mat.vt",
          "role": "teach",
          "context_zh": "田中在教室向同伴介绍近处课桌。",
          "jp": "これは机です。教室です。",
          "kana": "これはつくえです。きょうしつです。",
          "zh": "这是课桌。这是教室。",
          "goal_refs": [
            "draft.n5_04.goal.v"
          ]
        },
        {
          "id": "draft.n5_04.mat.vp",
          "role": "practice",
          "context_zh": "林拿起近处的笔，介绍给同伴。",
          "jp": "これはペンです。学校です。",
          "kana": "これはペンです。がっこうです。",
          "zh": "这是笔。这是学校。",
          "goal_refs": [
            "draft.n5_04.goal.v"
          ]
        },
        {
          "id": "draft.n5_04.mat.vc",
          "role": "check",
          "context_zh": "森指着自己手边的书，随后介绍老师。",
          "jp": "これは本です。先生です。",
          "kana": "これはほんです。せんせいです。",
          "zh": "这是书。这是老师。",
          "goal_refs": [
            "draft.n5_04.goal.v"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_04.q.vp1",
          "material_ref": "draft.n5_04.mat.vp",
          "goal_ref": "draft.n5_04.goal.v",
          "prompt": "练习中拿着什么？",
          "choices": [
            "笔",
            "书",
            "课桌"
          ],
          "answer": "笔",
          "feedback": "ペン指笔。"
        },
        {
          "id": "draft.n5_04.q.vp2",
          "material_ref": "draft.n5_04.mat.vp",
          "goal_ref": "draft.n5_04.goal.v",
          "prompt": "练习里的场所是什么？",
          "choices": [
            "学校",
            "教室",
            "老师"
          ],
          "answer": "学校",
          "feedback": "学校读がっこう。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_04.q.vc1",
          "material_ref": "draft.n5_04.mat.vc",
          "goal_ref": "draft.n5_04.goal.v",
          "prompt": "检查中手边是什么？",
          "choices": [
            "书",
            "笔",
            "桌子"
          ],
          "answer": "书",
          "feedback": "本在此读ほん。"
        },
        {
          "id": "draft.n5_04.q.vc2",
          "material_ref": "draft.n5_04.mat.vc",
          "goal_ref": "draft.n5_04.goal.v",
          "prompt": "检查中介绍谁？",
          "choices": [
            "老师",
            "学生",
            "学校"
          ],
          "answer": "老师",
          "feedback": "先生读せんせい。"
        }
      ],
      "review_zh": "把错词与假名配对；找不同物品或写标签再辨认。学、校、本、先仅在词语中识读。"
    },
    {
      "id": "draft.n5_04.lesson.g",
      "planning_key": "N5-04-L02",
      "type": "G",
      "title": "指物、选择和所属",
      "prerequisites": [
        "N5-03",
        "draft.n5_04.lesson.v"
      ],
      "prerequisite_status": "recommended_not_verified",
      "goals": [
        {
          "id": "draft.n5_04.goal.g",
          "text": "根据说话者与听者的位置选择指示词，并用の及だれ问答归属。"
        }
      ],
      "word_refs": [
        "draft.n5_04.word.places",
        "draft.n5_04.word.objects",
        "draft.n5_04.word.people",
        "draft.n5_04.word.pointer",
        "draft.n5_04.word.grammar",
        "draft.n5_04.word.schedule",
        "draft.n5_04.word.subjects"
      ],
      "explanation_zh": "两人分处时，以当前说话者为基准：近自己用これ，近对方用それ，离双方都远用あれ；它们可独立指物。需要接名词时分别用この／その／あの，如この本，不能说これ本。どれ独立问多个物中哪一个；どの必须接名词，如どの本。换说话人后近远要重算，真实交际还受共同视角影响；本稿题设固定两人分处的视角。の连接拥有者和物品：田中さんの本；だれの本问谁的书，これはだれの本ですか问这是谁的书，不是问哪本书。さん为人名后礼貌称呼；だれ用于询问人，不能替代どれ/どの。总纲明列これ/それ/あれ、この、どれ；その/あの/どの是同组必要对照，の和だれ是说明、询问归属的有限补充，不扩展方位或其他语法。",
      "common_mistake_zh": "「これ」可以单独指一本书；后面紧跟「本」时要说「この本」，不能说「これ本」。",
      "materials": [
        {
          "id": "draft.n5_04.mat.gt",
          "role": "teach",
          "context_zh": "田中在一端，林在另一端。两本书中一本在田中手边，林知道那是森的书。最后田中指着手边的书回答。",
          "jp": "田中：この本はだれの本ですか。林：森さんの本です。林：森さんの本はどれですか。田中：これです。",
          "kana": "たなか：このほんはだれのほんですか。はやし：もりさんのほんです。はやし：もりさんのほんはどれですか。たなか：これです。",
          "zh": "田中：这本书是谁的书？林：是森的书。林：森的书是哪一本？田中：这一本。",
          "goal_refs": [
            "draft.n5_04.goal.g"
          ]
        },
        {
          "id": "draft.n5_04.mat.gp",
          "role": "practice",
          "context_zh": "林说话，笔在听者田中手边，远离林；他们分处两端。",
          "jp": "林：それは田中さんのペンです。",
          "kana": "はやし：それはたなかさんのペンです。",
          "zh": "林：那是田中的笔。",
          "goal_refs": [
            "draft.n5_04.goal.g"
          ]
        },
        {
          "id": "draft.n5_04.mat.gc",
          "role": "check",
          "context_zh": "森说话，桌子在两人都够不到的远处；有多张桌子。",
          "jp": "森：あの机は林さんの机です。",
          "kana": "もり：あのつくえははやしさんのつくえです。",
          "zh": "森：远处那张桌子是林的桌子。",
          "goal_refs": [
            "draft.n5_04.goal.g"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_04.q.gp1",
          "material_ref": "draft.n5_04.mat.gp",
          "goal_ref": "draft.n5_04.goal.g",
          "prompt": "林指的是谁手边的笔？",
          "choices": [
            "田中手边",
            "林手边",
            "两人都远处"
          ],
          "answer": "田中手边",
          "feedback": "それ以林为说话者，指近听者的物。"
        },
        {
          "id": "draft.n5_04.q.gp2",
          "material_ref": "draft.n5_04.mat.gp",
          "goal_ref": "draft.n5_04.goal.g",
          "prompt": "若林在原情境中说‘那支笔’，应选哪个接ペン？",
          "choices": [
            "その",
            "それ",
            "この"
          ],
          "answer": "その",
          "feedback": "その后接ペン；それ独立使用。"
        },
        {
          "id": "draft.n5_04.q.gp3",
          "material_ref": "draft.n5_04.mat.gp",
          "goal_ref": "draft.n5_04.goal.g",
          "prompt": "若多个物品中问‘田中的笔是哪一个’，疑问词后不接名词，应选？",
          "choices": [
            "どれ",
            "どの",
            "だれ"
          ],
          "answer": "どれ",
          "feedback": "どれ独立指哪一个；どの要接名词，だれ问人。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_04.q.gc1",
          "material_ref": "draft.n5_04.mat.gc",
          "goal_ref": "draft.n5_04.goal.g",
          "prompt": "森说话且桌子离双方远，哪项可接机？",
          "choices": [
            "あの",
            "あれ",
            "その"
          ],
          "answer": "あの",
          "feedback": "あの接名词；あれ独立指物。"
        },
        {
          "id": "draft.n5_04.q.gc2",
          "material_ref": "draft.n5_04.mat.gc",
          "goal_ref": "draft.n5_04.goal.g",
          "prompt": "要问检查中的桌子是谁的，用哪个疑问词？",
          "choices": [
            "だれ",
            "どれ",
            "どの"
          ],
          "answer": "だれ",
          "feedback": "だれの机询问拥有者。"
        },
        {
          "id": "draft.n5_04.q.gc3",
          "material_ref": "draft.n5_04.mat.gc",
          "goal_ref": "draft.n5_04.goal.g",
          "prompt": "多张桌子中问‘哪张桌子’，哪项接机？",
          "choices": [
            "どの",
            "どれ",
            "だれ"
          ],
          "answer": "どの",
          "feedback": "どの机；どれ单独用。"
        }
      ],
      "review_zh": "错题先画说话人、听者、物品的位置，再判断后面是否有名词；归属题圈出の前的人。"
    },
    {
      "id": "draft.n5_04.lesson.r",
      "planning_key": "N5-04-L03",
