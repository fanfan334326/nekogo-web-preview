    {
      "id": "draft.n5_16.lesson.g",
      "planning_key": "N5-16-L02",
      "type": "G",
      "title": "把问价、邀约和过去活动连起来",
      "prerequisites": [
        "N5-16-L01"
      ],
      "goals": [
        {
          "id": "draft.n5_16.lesson.g.goal",
          "text": "把问价、邀约和过去活动连起来"
        }
      ],
      "word_refs": [
        "draft.n5_16.word.1",
        "draft.n5_16.word.2",
        "draft.n5_16.word.3",
        "draft.n5_16.word.4",
        "draft.n5_16.word.5",
        "draft.n5_16.word.6"
      ],
      "explanation_zh": "问价用「いくらですか」。发出邀约可以用「ませんか」。回顾昨天时，把动词改成过去式。",
      "common_mistake_zh": "「昨日、何を買いましたか」问昨天买了什么；想约明天一起买东西，用「明日、一緒に買い物に行きませんか」。",
      "materials": [
        {
          "id": "draft.n5_16.lesson.g.teach",
          "role": "teach",
          "jp": "A：昨日、何をしましたか。B：駅の店でシャツを買いました。A：明日、一緒に買い物に行きませんか。",
          "goal_refs": [
            "draft.n5_16.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_16.lesson.g.practice",
          "role": "practice",
          "jp": "A：これはいくらですか。B：千円です。",
          "goal_refs": [
            "draft.n5_16.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_16.lesson.g.check",
          "role": "check",
          "jp": "A：昨日、靴を買いましたか。B：いいえ、〔　〕。",
          "goal_refs": [
            "draft.n5_16.lesson.g.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_16.lesson.g.practice.q1",
