            "draft.n5_16.word.5",
            "draft.n5_16.word.6"
          ],
          "prompt": "A 想知道什么？",
          "choices": [
            "见面时间",
            "东西的价格",
            "回家的路线"
          ],
          "answer": "东西的价格",
          "feedback": "「いくら」是在问价格。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_16.lesson.g.check.q1",
          "material_ref": "draft.n5_16.lesson.g.check",
          "goal_ref": "draft.n5_16.lesson.g.goal",
