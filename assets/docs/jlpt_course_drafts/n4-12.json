    {
      "id": "draft.n4_12.lesson.g",
      "planning_key": "N4-12-L02",
      "type": "G",
      "title": "〜前に・〜てから",
      "prerequisites": [
        "N4-12-L01"
      ],
      "goals": [
        {
          "id": "draft.n4_12.lesson.g.goal",
          "text": "〜前に・〜てから"
        }
      ],
      "word_refs": [
        "draft.n4_12.word.1",
        "draft.n4_12.word.2",
        "draft.n4_12.word.3",
        "draft.n4_12.word.4"
      ],
      "explanation_zh": "「动词原形＋前に」表示在这个动作之前先做主句的动作。「会場に入る前に、受付をする」就是先报到再进场。「动词て形＋から」表示先完成这个动作，再做主句的动作。",
      "materials": [
        {
          "id": "draft.n4_12.lesson.g.mat.teach",
          "role": "teach",
          "jp": "会場に入る前に、入口で受付をしてください。"
        },
        {
          "id": "draft.n4_12.lesson.g.mat.practice",
          "role": "practice",
          "jp": "受付をしてから、展示を見てください。"
        },
        {
          "id": "draft.n4_12.lesson.g.mat.check",
          "role": "check",
          "jp": "展示室に入る＿に、携帯電話の音を切ってください。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_12.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_12.lesson.g.mat.practice",
          "goal_ref": "draft.n4_12.lesson.g.goal",
          "word_refs": [
            "draft.n4_12.word.1",
            "draft.n4_12.word.2",
            "draft.n4_12.word.3",
            "draft.n4_12.word.4"
          ],
          "prompt": "哪件事先做？",
          "choices": [
            "离开会场",
            "报到",
            "看展览"
          ],
          "answer": "报到",
          "feedback": "正确答案是「报到」。原句：受付をしてから、展示を見てください。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_12.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_12.lesson.g.mat.check",
          "goal_ref": "draft.n4_12.lesson.g.goal",
          "word_refs": [
            "draft.n4_12.word.1",
            "draft.n4_12.word.2",
            "draft.n4_12.word.3",
            "draft.n4_12.word.4"
          ],
          "prompt": "如果要表达进入前就关声音，该选什么？",
          "choices": [
            "前",
            "後",
            "次"
          ],
          "answer": "前",
          "feedback": "「入る前に」表示在进展厅之前，所以先把手机调成静音。"
        }
      ],
      "common_mistake_zh": "「受付をしてから、展示を見る」和「展示を見る前に、受付をする」的顺序相同，都是先报到。注意两句的动词顺序相反。"
    },
