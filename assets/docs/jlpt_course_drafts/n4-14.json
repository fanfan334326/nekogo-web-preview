    {
      "id": "draft.n4_14.lesson.g",
      "planning_key": "N4-14-L02",
      "type": "G",
      "title": "〜たら・〜なら",
      "prerequisites": [
        "N4-14-L01"
      ],
      "goals": [
        {
          "id": "draft.n4_14.lesson.g.goal",
          "text": "〜たら・〜なら"
        }
      ],
      "word_refs": [
        "draft.n4_14.word.1",
        "draft.n4_14.word.2",
        "draft.n4_14.word.3",
        "draft.n4_14.word.4"
      ],
      "explanation_zh": "「たら」常给出满足后才做后项的条件；「なら」常接对方提到的情况，随后给建议。先判断上下句关系。",
      "materials": [
        {
          "id": "draft.n4_14.lesson.g.mat.teach",
          "role": "teach",
          "jp": "駅に着いたら電話してください。電車で行くなら、早めに出たほうがいいです。"
        },
        {
          "id": "draft.n4_14.lesson.g.mat.practice",
          "role": "practice",
          "jp": "初めて行くなら、地図を持っていったほうがいいです。"
        },
        {
          "id": "draft.n4_14.lesson.g.mat.check",
          "role": "check",
          "jp": "駅に＿、入口で待っていてください。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_14.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_14.lesson.g.mat.practice",
          "goal_ref": "draft.n4_14.lesson.g.goal",
          "word_refs": [
            "draft.n4_14.word.1",
            "draft.n4_14.word.2",
            "draft.n4_14.word.3",
            "draft.n4_14.word.4"
          ],
          "prompt": "建议针对什么情况？",
          "choices": [
            "去过多次",
            "已经到达",
            "第一次去"
          ],
          "answer": "第一次去",
          "feedback": "正确答案是「第一次去」。原句：初めて行くなら、地図を持っていったほうがいいです。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_14.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_14.lesson.g.mat.check",
          "goal_ref": "draft.n4_14.lesson.g.goal",
          "word_refs": [
            "draft.n4_14.word.1",
            "draft.n4_14.word.2",
            "draft.n4_14.word.3",
            "draft.n4_14.word.4"
          ],
          "prompt": "选出表示到达后再行动的接续。",
          "choices": [
            "着く前に",
            "着いたら",
            "着くまで"
          ],
          "answer": "着いたら",
          "feedback": "「着いたら」表示到达之后。「着く前に」表示到达之前，「着くまで」表示直到到达为止。"
        }
      ],
      "common_mistake_zh": "「駅に着いたら」表示到站之后才做下一件事；「電車で行くなら」接对方提到的出行方式，后面可以给出发前的建议。"
    },
