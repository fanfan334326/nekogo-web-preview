    {
      "id": "draft.n4_05.lesson.g",
      "planning_key": "N4-05-L02",
      "type": "G",
      "title": "〜ことができます",
      "prerequisites": [
        "N4-05-L01"
      ],
      "goals": [
        {
          "id": "draft.n4_05.lesson.g.goal",
          "text": "〜ことができます"
        }
      ],
      "word_refs": [
        "draft.n4_05.word.1",
        "draft.n4_05.word.2",
        "draft.n4_05.word.3",
        "draft.n4_05.word.4"
      ],
      "explanation_zh": "动词原形加「ことができます」表示能力或条件允许。面试时可用具体时间说明限制。",
      "materials": [
        {
          "id": "draft.n4_05.lesson.g.mat.teach",
          "role": "teach",
          "jp": "土曜日なら、午後から働くことができます。"
        },
        {
          "id": "draft.n4_05.lesson.g.mat.practice",
          "role": "practice",
          "jp": "荷物を運ぶことはできますが、車の運転はできません。"
        },
        {
          "id": "draft.n4_05.lesson.g.mat.check",
          "role": "check",
          "jp": "夜の勤務を希望しています。六時から働く＿ができます。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_05.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_05.lesson.g.mat.practice",
          "goal_ref": "draft.n4_05.lesson.g.goal",
          "word_refs": [
            "draft.n4_05.word.1",
            "draft.n4_05.word.2",
            "draft.n4_05.word.3",
            "draft.n4_05.word.4"
          ],
          "prompt": "说话人能做什么？",
          "choices": [
            "开车",
            "周日早上上班",
            "搬运货物"
          ],
          "answer": "搬运货物",
          "feedback": "正确答案是「搬运货物」。原句：荷物を運ぶことはできますが、車の運転はできません。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_05.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_05.lesson.g.mat.check",
          "goal_ref": "draft.n4_05.lesson.g.goal",
          "word_refs": [
            "draft.n4_05.word.1",
            "draft.n4_05.word.2",
            "draft.n4_05.word.3",
            "draft.n4_05.word.4"
          ],
          "prompt": "空格里填什么？",
          "choices": [
            "ところ",
            "こと",
            "もの"
          ],
          "answer": "こと",
          "feedback": "正确答案是「こと」。原文：夜の勤務を希望しています。六時から働く＿ができます。"
        }
      ],
      "common_mistake_zh": "表示能力时用「働くことができます」。「働きます」要先改成辞书形「働く」，再接「こと」。"
    },
