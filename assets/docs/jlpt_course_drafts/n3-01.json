        "draft.n3_01.word.4"
      ],
      "explanation_zh": "「担当」对应由谁处理，「締め切り」是必须完成的时限。「見通し」用于报告预计状况。",
      "materials": [
        {
          "id": "draft.n3_01.lesson.v.teach",
          "role": "teach",
          "jp": "集計の担当は佐々木さんで、締め切りは木曜です。",
          "goal_refs": [
            "draft.n3_01.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n3_01.lesson.v.practice",
          "role": "practice",
          "jp": "修正は夕方までに終わる見通しです。",
          "goal_refs": [
            "draft.n3_01.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n3_01.lesson.v.check",
          "role": "check",
          "jp": "来週からの担当者に、未対応の案件を引き継ぎます。",
          "goal_refs": [
            "draft.n3_01.lesson.v.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n3_01.lesson.v.practice.q1",
          "material_ref": "draft.n3_01.lesson.v.practice",
          "goal_ref": "draft.n3_01.lesson.v.goal",
