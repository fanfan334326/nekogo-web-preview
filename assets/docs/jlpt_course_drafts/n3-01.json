          "answer": "预计完成时间",
          "feedback": "「見通し」给出当前预估。"
        }
      ],
      "check": [
        {
          "id": "draft.n3_01.lesson.v.check.q1",
          "material_ref": "draft.n3_01.lesson.v.check",
