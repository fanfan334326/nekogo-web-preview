  "lessons": [
    {
      "id": "draft.n5_02.lesson.v",
      "planning_key": "N5-02-L01",
      "type": "V",
      "theme": "人物与家庭",
      "title": "称谓、身份和年龄",
      "prerequisites": [
        "N5-01"
      ],
      "goals": [
        {
          "id": "draft.n5_02.goal.v",
          "text": "在虚构人物情境中辨认对外自称父母、对方父母、身份和给定年龄。"
        }
      ],
      "word_refs": [
        "draft.n5_02.word.chichi",
        "draft.n5_02.word.haha",
        "draft.n5_02.word.otousan",
        "draft.n5_02.word.okaasan",
        "draft.n5_02.word.kodomo",
        "draft.n5_02.word.tomodachi",
        "draft.n5_02.word.gakusei",
        "draft.n5_02.word.sensei",
        "draft.n5_02.word.age",
        "draft.n5_02.word.ages",
        "draft.n5_02.word.san",
        "draft.n5_02.word.particles"
      ],
      "explanation_zh": "辅助复习：私（わたし）是我；は标话题读わ，です是礼貌断定，か标疑问，さん接在人名后，はい表示是。对外介绍自己父母常用父、母；问对方的父母用お父さん、お母さん。称呼自己的父母也可能用お父さん、お母さん，不能机械等同于所有场合。学生、先生是身份，不是亲属关系。何歳是几岁；おいくつ较礼貌，但年龄可能敏感，先获得同意，不追问。七歳读ななさい、九歳读きゅうさい、三十歳读さんじゅっさい：只要求这三种，其他年龄给读音。内外称谓、年龄提问及语境自然度待语言专家审核。",
      "materials": [
        {
          "id": "draft.n5_02.mat.vt",
          "role": "teach",
          "jp": "私の父は先生です。お母さんはおいくつですか。",
          "kana": "わたしのちちはせんせいです。おかあさんはおいくつですか。",
          "zh": "我的父亲是老师。您的母亲多大年纪？（已同意询问）",
          "goal_refs": [
            "draft.n5_02.goal.v"
          ]
        },
        {
          "id": "draft.n5_02.mat.vp",
          "role": "practice",
          "jp": "ミナの母は学生です。母は三十歳です。",
          "kana": "みなのはははがくせいです。はははさんじゅっさいです。",
          "zh": "米娜的母亲是学生。母亲三十岁。米娜向外人介绍。",
          "goal_refs": [
            "draft.n5_02.goal.v"
          ],
          "context_zh": "虚构人物译名：ミナ＝米娜。本段由米娜对外介绍家人。"
        },
        {
          "id": "draft.n5_02.mat.vc",
          "role": "check",
          "jp": "ユイの父は先生です。父は三十歳です。",
          "kana": "ゆいのちちはせんせいです。ちちはさんじゅっさいです。",
          "zh": "优衣的父亲是老师。父亲三十岁。优衣向外人介绍。",
          "goal_refs": [
            "draft.n5_02.goal.v"
          ],
          "context_zh": "虚构人物译名：ユイ＝优衣。本段由优衣对外介绍家人。"
        }
      ],
