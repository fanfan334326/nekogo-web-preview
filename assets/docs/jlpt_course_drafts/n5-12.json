    {
      "id": "draft.n5_12.lesson.g",
      "planning_key": "N5-12-L02",
      "type": "G",
      "title": "说明原因并提出简单请求",
      "prerequisites": [
        "N5-12-L01"
      ],
      "goals": [
        {
          "id": "draft.n5_12.lesson.g.goal",
          "text": "说明原因并提出简单请求"
        }
      ],
      "word_refs": [
        "draft.n5_12.word.1",
        "draft.n5_12.word.2",
        "draft.n5_12.word.3",
        "draft.n5_12.word.4",
        "draft.n5_12.word.5",
        "draft.n5_12.word.6"
      ],
      "explanation_zh": "用「Xが痛いです」说哪里疼。「から」可以说明原因，「水をください」可以开口要水。",
      "common_mistake_zh": "「足が痛いですから、休みます」先说原因，再说要做什么。要水时用「水をください」，水后面用「を」。",
      "materials": [
        {
          "id": "draft.n5_12.lesson.g.teach",
          "role": "teach",
          "jp": "頭が痛いですから、少し休みます。すみません、水をください。",
          "goal_refs": [
            "draft.n5_12.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_12.lesson.g.practice",
          "role": "practice",
          "jp": "足が痛いですから、ここで休みます。",
          "goal_refs": [
            "draft.n5_12.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_12.lesson.g.check",
          "role": "check",
          "jp": "すみません。水を〔　〕。",
          "goal_refs": [
            "draft.n5_12.lesson.g.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_12.lesson.g.practice.q1",
          "material_ref": "draft.n5_12.lesson.g.practice",
          "goal_ref": "draft.n5_12.lesson.g.goal",
          "word_refs": [
            "draft.n5_12.word.1",
            "draft.n5_12.word.2",
            "draft.n5_12.word.3",
            "draft.n5_12.word.4",
            "draft.n5_12.word.5",
            "draft.n5_12.word.6"
          ],
          "prompt": "为什么要休息？",
          "choices": [
            "脚疼",
            "手疼",
            "头疼"
          ],
          "answer": "脚疼",
          "feedback": "「から」前面的「足が痛いです」是原因。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_12.lesson.g.check.q1",
          "material_ref": "draft.n5_12.lesson.g.check",
          "goal_ref": "draft.n5_12.lesson.g.goal",
          "word_refs": [
            "draft.n5_12.word.1",
            "draft.n5_12.word.2",
            "draft.n5_12.word.3",
            "draft.n5_12.word.4",
            "draft.n5_12.word.5",
            "draft.n5_12.word.6"
          ],
          "prompt": "想请别人给水，该填什么？",
          "choices": [
            "休みます",
            "痛いです",
            "ください"
          ],
          "answer": "ください",
          "feedback": "「水をください」是请给我水。"
        }
      ]
    },
