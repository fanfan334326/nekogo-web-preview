      "type": "V",
      "title": "辨认季节和天气词",
      "prerequisites": [
        "N5-09"
      ],
      "goals": [
        {
          "id": "draft.n5_10.lesson.v.goal",
          "text": "辨认季节和天气词"
        }
      ],
      "word_refs": [
        "draft.n5_10.word.1",
        "draft.n5_10.word.2",
        "draft.n5_10.word.3",
        "draft.n5_10.word.4",
        "draft.n5_10.word.5",
        "draft.n5_10.word.6"
      ],
      "explanation_zh": "「暑い」「寒い」可以形容天气带来的冷热感受。「晴れ」「雨」「雪」用来描述天气。",
      "materials": [
        {
          "id": "draft.n5_10.lesson.v.teach",
          "role": "teach",
          "jp": "夏は暑いです。冬は寒いです。",
          "goal_refs": [
            "draft.n5_10.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n5_10.lesson.v.practice",
          "role": "practice",
          "jp": "今日は雪です。",
          "goal_refs": [
            "draft.n5_10.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n5_10.lesson.v.check",
          "role": "check",
          "jp": "春のあとに夏が来ます。",
          "goal_refs": [
