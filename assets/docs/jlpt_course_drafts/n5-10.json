    {
      "id": "draft.n5_10.lesson.g",
      "planning_key": "N5-10-L02",
      "type": "G",
      "title": "用「暑いです」「寒いです」说感受",
      "prerequisites": [
        "N5-10-L01"
      ],
      "goals": [
        {
          "id": "draft.n5_10.lesson.g.goal",
          "text": "用「暑いです」「寒いです」说感受"
        }
      ],
      "word_refs": [
        "draft.n5_10.word.1",
        "draft.n5_10.word.2",
        "draft.n5_10.word.3",
        "draft.n5_10.word.4",
        "draft.n5_10.word.5",
        "draft.n5_10.word.6"
      ],
      "explanation_zh": "天气的冷热可以直接用「暑いです」「寒いです」表达。问别人今天冷不冷，可以说「今日は寒いですか」。",
      "common_mistake_zh": "说今天不热用「今日は暑くないです」。「暑い」变否定时，词尾的「い」换成「くない」。",
      "materials": [
        {
          "id": "draft.n5_10.lesson.g.teach",
          "role": "teach",
          "jp": "今日は晴れです。少し暑いです。",
          "goal_refs": [
            "draft.n5_10.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_10.lesson.g.practice",
          "role": "practice",
          "jp": "今日はとても寒いです。",
          "goal_refs": [
            "draft.n5_10.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_10.lesson.g.check",
          "role": "check",
          "jp": "今日は暑いですか。いいえ、〔　〕。",
          "goal_refs": [
            "draft.n5_10.lesson.g.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_10.lesson.g.practice.q1",
