            "draft.n5_10.word.6"
          ],
          "prompt": "说话的人觉得今天怎么样？",
          "choices": [
            "很冷",
            "有点热",
            "很热"
          ],
          "answer": "很冷",
          "feedback": "「とても」加强程度，「寒い」是冷。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_10.lesson.g.check.q1",
          "material_ref": "draft.n5_10.lesson.g.check",
          "goal_ref": "draft.n5_10.lesson.g.goal",
          "word_refs": [
            "draft.n5_10.word.1",
            "draft.n5_10.word.2",
