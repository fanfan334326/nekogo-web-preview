    {
      "id": "draft.n5_14.lesson.g",
      "planning_key": "N5-14-L02",
      "type": "G",
      "title": "礼貌地邀请和商定计划",
      "prerequisites": [
        "N5-14-L01"
      ],
      "goals": [
        {
          "id": "draft.n5_14.lesson.g.goal",
          "text": "礼貌地邀请和商定计划"
        }
      ],
      "word_refs": [
        "draft.n5_14.word.1",
        "draft.n5_14.word.2",
        "draft.n5_14.word.3",
        "draft.n5_14.word.4",
        "draft.n5_14.word.5",
        "draft.n5_14.word.6"
      ],
      "explanation_zh": "用「一緒に行きませんか」邀请对方。谈好之后，可用「〜ましょう」提议下一步。「行くつもりです」表示自己打算去。",
      "common_mistake_zh": "「一緒に行きませんか」是在邀请对方。「行くつもりです」只说明自己的打算。对方改时间后，可以用「三時に会いましょう」确认。",
      "materials": [
        {
          "id": "draft.n5_14.lesson.g.teach",
          "role": "teach",
          "jp": "A：一緒に映画を見ませんか。B：いいですね。二時に会いましょう。",
          "goal_refs": [
            "draft.n5_14.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_14.lesson.g.practice",
          "role": "practice",
          "jp": "一緒に昼ご飯を食べませんか。",
          "goal_refs": [
            "draft.n5_14.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_14.lesson.g.check",
          "role": "check",
          "jp": "週末は家で勉強するつもりです。",
          "goal_refs": [
            "draft.n5_14.lesson.g.goal"
          ]
        }
      ],
      "practice": [
        {
