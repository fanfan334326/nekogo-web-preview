          ]
        },
        {
          "id": "draft.n4_03.lesson.g.practice",
          "role": "practice",
          "jp": "風が強かったら、船には乗りません。",
          "goal_refs": [
            "draft.n4_03.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n4_03.lesson.g.check",
          "role": "check",
          "jp": "午後に雨がやんだら、海を見に行きましょう。",
