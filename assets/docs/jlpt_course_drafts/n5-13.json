        "draft.n5_13.word.5",
        "draft.n5_13.word.6"
      ],
      "explanation_zh": "「から」标起点，「まで」标范围终点。「へ／に」可标移动目的地，「と」标同行人。",
      "common_mistake_zh": "「家から駅まで」是从家到车站，调换地点就变成回程。「友達と」用来补充和谁一起走。",
      "materials": [
        {
          "id": "draft.n5_13.lesson.g.teach",
          "role": "teach",
          "jp": "友達と学校から公園まで歩きます。",
          "goal_refs": [
            "draft.n5_13.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_13.lesson.g.practice",
          "role": "practice",
          "jp": "家から駅まで歩きます。",
          "goal_refs": [
            "draft.n5_13.lesson.g.goal"
          ]
        },
        {
          "id": "draft.n5_13.lesson.g.check",
          "role": "check",
          "jp": "友達〔　〕公園へ行きます。",
          "goal_refs": [
            "draft.n5_13.lesson.g.goal"
          ]
