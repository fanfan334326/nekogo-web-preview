          "choices": [
            "车站",
            "学校",
            "家"
          ],
          "answer": "家",
          "feedback": "「家から」标出起点。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_13.lesson.g.check.q1",
          "material_ref": "draft.n5_13.lesson.g.check",
