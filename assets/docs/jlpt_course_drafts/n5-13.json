            "draft.n5_13.word.3",
            "draft.n5_13.word.4",
            "draft.n5_13.word.5",
            "draft.n5_13.word.6"
          ],
          "prompt": "上完课之后做什么？",
          "choices": [
            "去公园",
            "回家",
            "去学校"
          ],
          "answer": "回家",
          "feedback": "「家に帰ります」是回家。"
        }
      ]
    },
    {
