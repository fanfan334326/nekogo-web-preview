  "lessons": [
    {
      "id": "draft.n5_13.lesson.v",
      "planning_key": "N5-13-L01",
      "type": "V",
      "title": "认出去、来和回去",
      "prerequisites": [
        "N5-12"
      ],
      "goals": [
        {
          "id": "draft.n5_13.lesson.v.goal",
          "text": "认出去、来和回去"
        }
      ],
      "word_refs": [
        "draft.n5_13.word.1",
        "draft.n5_13.word.2",
        "draft.n5_13.word.3",
        "draft.n5_13.word.4",
        "draft.n5_13.word.5",
        "draft.n5_13.word.6"
      ],
      "explanation_zh": "用「行きます」说去某地，「来ます」说来到谈话所指的地方，「帰ります」说回到家等原来的地方。本单元介绍自己家人的说法：兄（あに）哥哥、姉（あね）姐姐、弟（おとうと）弟弟、妹（いもうと）妹妹。",
      "materials": [
        {
          "id": "draft.n5_13.lesson.v.teach",
          "role": "teach",
          "jp": "朝、学校へ行きます。夕方、家に帰ります。",
          "goal_refs": [
            "draft.n5_13.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n5_13.lesson.v.practice",
          "role": "practice",
          "jp": "ここは学校です。友達がもうすぐ来ます。",
          "goal_refs": [
            "draft.n5_13.lesson.v.goal"
          ]
        },
        {
          "id": "draft.n5_13.lesson.v.check",
          "role": "check",
          "jp": "授業のあと、家に帰ります。",
          "goal_refs": [
            "draft.n5_13.lesson.v.goal"
          ]
        }
      ],
      "practice": [
        {
          "id": "draft.n5_13.lesson.v.practice.q1",
          "material_ref": "draft.n5_13.lesson.v.practice",
          "goal_ref": "draft.n5_13.lesson.v.goal",
          "word_refs": [
            "draft.n5_13.word.1",
            "draft.n5_13.word.2",
            "draft.n5_13.word.3",
            "draft.n5_13.word.4",
            "draft.n5_13.word.5",
            "draft.n5_13.word.6"
          ],
          "prompt": "朋友马上去哪儿？",
          "choices": [
            "说话人所在的学校",
            "朋友家",
            "公园"
          ],
          "answer": "说话人所在的学校",
          "feedback": "「ここは学校です」确定地点，「来ます」说来到这里。"
        }
      ],
      "check": [
        {
          "id": "draft.n5_13.lesson.v.check.q1",
          "material_ref": "draft.n5_13.lesson.v.check",
          "goal_ref": "draft.n5_13.lesson.v.goal",
