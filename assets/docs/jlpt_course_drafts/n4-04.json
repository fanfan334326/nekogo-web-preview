    {
      "id": "draft.n4_04.lesson.g",
      "planning_key": "N4-04-L02",
      "type": "G",
      "title": "〜てもいいです・〜てはいけません",
      "prerequisites": [
        "N4-04-L01"
      ],
      "goals": [
        {
          "id": "draft.n4_04.lesson.g.goal",
          "text": "〜てもいいです・〜てはいけません"
        }
      ],
      "word_refs": [
        "draft.n4_04.word.1",
        "draft.n4_04.word.2",
        "draft.n4_04.word.3",
        "draft.n4_04.word.4"
      ],
      "explanation_zh": "动词て形后接「もいい」表示许可，接「はいけない」表示禁止。问规则时可把许可句改成问句。",
      "materials": [
        {
          "id": "draft.n4_04.lesson.g.mat.teach",
          "role": "teach",
          "jp": "共用の洗濯機を夜に使ってもいいですか。"
        },
        {
          "id": "draft.n4_04.lesson.g.mat.practice",
          "role": "practice",
          "jp": "ここに自転車を置いてはいけません。"
        },
        {
          "id": "draft.n4_04.lesson.g.mat.check",
          "role": "check",
          "jp": "共用の廊下に荷物を置いて＿。"
        }
      ],
      "practice": [
        {
          "id": "draft.n4_04.lesson.g.mat.practice.q1",
          "material_ref": "draft.n4_04.lesson.g.mat.practice",
          "goal_ref": "draft.n4_04.lesson.g.goal",
          "word_refs": [
            "draft.n4_04.word.1",
            "draft.n4_04.word.2",
            "draft.n4_04.word.3",
            "draft.n4_04.word.4"
          ],
          "prompt": "这条规则禁止什么？",
          "choices": [
            "把自行车停在这里",
            "夜间洗衣服",
            "使用公共走廊"
          ],
          "answer": "把自行车停在这里",
          "feedback": "正确答案是「把自行车停在这里」。原句：ここに自転車を置いてはいけません。"
        }
      ],
      "check": [
        {
          "id": "draft.n4_04.lesson.g.mat.check.q1",
          "material_ref": "draft.n4_04.lesson.g.mat.check",
          "goal_ref": "draft.n4_04.lesson.g.goal",
          "word_refs": [
            "draft.n4_04.word.1",
            "draft.n4_04.word.2",
            "draft.n4_04.word.3",
            "draft.n4_04.word.4"
          ],
          "prompt": "禁止を表す表現は？",
          "choices": [
            "もいいです",
            "くださいました",
            "はいけません"
          ],
          "answer": "はいけません",
          "feedback": "正确答案是「はいけません」。原文：共用の廊下に荷物を置いて＿。"
        }
      ],
      "common_mistake_zh": "「置いてもいいです」表示允许放，「置いてはいけません」表示禁止放。先看「て」形后接的是哪一项。"
    },
