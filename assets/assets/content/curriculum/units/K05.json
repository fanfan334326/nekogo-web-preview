  "errorReasons": [
    {
      "id": "er.kata.nu.shape_su",
      "knowledgePointId": "kp.kata.nu",
      "wrongChoice": "ス",
      "explainZh": "看漏小圈了：ス 只有撇和横；ヌ 在右末端多绕一个圈，念 nu。",
      "correctAudioKey": "audio.kata.nu",
      "confuseWith": "kp.kata.su"
    },
    {
      "id": "er.kata.nu.sound_su",
      "knowledgePointId": "kp.kata.nu",
      "wrongChoice": "su",
      "explainZh": "听混了：nu 起头是鼻腔的 n，su 起头是齿缝的 s；先哼一下再接 u 就是 nu。",
      "correctAudioKey": "audio.kata.nu",
      "confuseWith": "kp.kata.su"
    }
  ]
