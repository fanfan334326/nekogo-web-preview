{
  "schemaVersion": 1,
  "id": "K05",
  "stageId": "stage.katakana_seion",
  "order": 5,
  "title": "ナ行",
  "titleZh": "片假名 ナ行（ナニヌネノ）",
  "rowId": "na",
  "knowledgePoints": [
    {
      "id": "kp.kata.na",
      "kana": "ナ",
      "romaji": "na",
      "audioKey": "audio.kata.na",
      "confusableIds": [],
      "tipZh": "片假名 ナ 两笔：撇、竖钩——像「刀」但那一笔是竖钩不是横折钩。"
    },
    {
      "id": "kp.kata.ni",
      "kana": "ニ",
      "romaji": "ni",
      "audioKey": "audio.kata.ni",
      "confusableIds": [],
      "tipZh": "片假名 ニ 就是汉字「二」：上横短、下横长。"
    },
    {
      "id": "kp.kata.nu",
      "kana": "ヌ",
      "romaji": "nu",
      "audioKey": "audio.kata.nu",
      "confusableIds": ["kp.kata.su"],
      "tipZh": "片假名 ヌ 和「メ」同形、多右下一点圈：有圈念 nu，没圈念 me。"
    },
    {
      "id": "kp.kata.ne",
      "kana": "ネ",
      "romaji": "ne",
      "audioKey": "audio.kata.ne",
      "confusableIds": [],
      "tipZh": "片假名 ネ 三笔：横折、竖、底横——像把「几」加上一横托盘。"
    },
    {
      "id": "kp.kata.no",
      "kana": "ノ",
      "romaji": "no",
      "audioKey": "audio.kata.no",
      "confusableIds": [],
      "tipZh": "片假名 ノ 只有一笔：从右上到左下的长撇，一鼓作气不带钩。"
    }
  ],
  "teach": [
    {
      "id": "K05.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.kata.na",
      "promptZh": "片假名 ナ，罗马音 na。",
      "audioKey": "audio.kata.na",
      "noteZh": "ナ 来自「那」的左耳刀侧写：先撇、后竖钩。"
    },
    {
      "id": "K05.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.kata.na",
      "promptZh": "点喇叭听 ナ：舌尖顶上去的「哪」。",
      "audioKey": "audio.kata.na"
    },
    {
      "id": "K05.teach.3",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ni",
      "promptZh": "第二个：ニ，罗马音 ni。",
      "audioKey": "audio.kata.ni",
      "noteZh": "ニ = 汉字「二」，好记；「ニ十」的ニ就是它。"
    },
    {
      "id": "K05.teach.4",
      "type": "listen",
      "knowledgePointId": "kp.kata.ni",
      "promptZh": "听 ニ：鼻音 n 起头的「尼」。",
      "audioKey": "audio.kata.ni"
    },
    {
      "id": "K05.teach.5",
      "type": "compare",
      "knowledgePointId": "kp.kata.nu",
      "promptZh": "对比 ヌ / ス：两个都有撇横；ヌ 右下方多绕一个小圈。"
    },
    {
      "id": "K05.teach.6",
      "type": "introduce",
      "knowledgePointId": "kp.kata.nu",
      "promptZh": "第三个：ヌ，罗马音 nu。",
      "audioKey": "audio.kata.nu",
      "noteZh": "圈要贴着横的末端写，写成独立一团就变另一个字了。"
    },
    {
      "id": "K05.teach.7",
      "type": "listen",
      "knowledgePointId": "kp.kata.nu",
      "promptZh": "听 ヌ：鼻音起头的「努」。",
      "audioKey": "audio.kata.nu"
    },
    {
      "id": "K05.teach.8",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ne",
      "promptZh": "第四个：ネ，罗马音 ne。",
      "audioKey": "audio.kata.ne",
      "noteZh": "ネ 的竖要出头一点点，底横托住整字。"
    },
    {
      "id": "K05.teach.9",
      "type": "listen",
      "knowledgePointId": "kp.kata.ne",
      "promptZh": "听 ネ：鼻音起头的「捏」前段。",
      "audioKey": "audio.kata.ne"
    },
    {
      "id": "K05.teach.10",
      "type": "introduce",
      "knowledgePointId": "kp.kata.no",
      "promptZh": "第五个：ノ，罗马音 no。",
      "audioKey": "audio.kata.no",
      "noteZh": "ノ 一笔长撇，是片假名里最简单的字之一。"
    },
    {
      "id": "K05.teach.11",
      "type": "listen",
      "knowledgePointId": "kp.kata.no",
      "promptZh": "听 ノ：圆唇「诺」。",
      "audioKey": "audio.kata.no"
    },
    {
      "id": "K05.teach.12",
      "type": "stroke_hint",
      "knowledgePointId": "kp.kata.nu",
      "promptZh": "看笔顺：ヌ 一共 3 笔。",
      "noteZh": "① 竖撇；② 长横；③ 从横的右端起笔绕一个小圈收回。圈要小、贴笔。"
    }
  ],
