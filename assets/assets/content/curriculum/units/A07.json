  "title": "ま行",
  "titleZh": "平假名 ま行（m 音）",
  "rowId": "ma",
  "knowledgePoints": [
    {
      "id": "kp.hira.ma",
      "kana": "ま",
      "romaji": "ma",
      "audioKey": "audio.hira.ma",
      "confusableIds": [
        "kp.hira.me"
      ],
      "tipZh": "ま 有三笔：两横，再写穿过两横、下方绕小圈的竖弯。"
    },
    {
      "id": "kp.hira.mi",
      "kana": "み",
      "romaji": "mi",
      "audioKey": "audio.hira.mi",
      "confusableIds": [],
      "tipZh": "み 有两笔，第一笔下方绕回，第二笔从右上向下与它交叉。"
    },
    {
      "id": "kp.hira.mu",
      "kana": "む",
      "romaji": "mu",
      "audioKey": "audio.hira.mu",
      "confusableIds": [
        "kp.hira.nu"
      ],
      "tipZh": "む 有三笔：横、带圈后向右伸展的曲线、右上短点；别漏最后一点。"
    },
    {
      "id": "kp.hira.me",
      "kana": "め",
      "romaji": "me",
      "audioKey": "audio.hira.me",
      "confusableIds": [
        "kp.hira.nu"
      ],
      "tipZh": "め 有两笔交叉，下方呈较大弧形；右下不加 ぬ 的小圈。"
    },
    {
      "id": "kp.hira.mo",
      "kana": "も",
      "romaji": "mo",
      "audioKey": "audio.hira.mo",
      "confusableIds": [],
      "tipZh": "も 有三笔：先写向右弯的竖弯，再写穿过它的两横；不是两个竖。"
    }
  ],
