      "knowledgePointId": "kp.kata.ki",
      "promptZh": "罗马音 ki 对应哪个片假名？",
      "stem": "ki",
      "choices": ["キ", "ク", "カ", "ケ"],
      "answer": "キ"
    },
    {
      "id": "K02.quiz.2",
      "type": "choose_romaji",
      "knowledgePointId": "kp.kata.ko",
      "promptZh": "「コ」的罗马音是？",
      "stem": "コ",
      "choices": ["ko", "ku", "ka", "so"],
      "answer": "ko",
      "errorReasonId": "er.kata.ko.shape_ku"
    },
    {
      "id": "K02.quiz.3",
      "type": "listen_choose",
      "knowledgePointId": "kp.kata.ka",
      "promptZh": "听音，选出你听到的罗马音。",
      "audioKey": "audio.kata.ka",
      "choices": ["ka", "ga", "ki", "ko"],
      "answer": "ka"
    },
    {
      "id": "K02.quiz.4",
      "type": "match",
      "knowledgePointId": "kp.kata.ku",
      "promptZh": "独立测验：カ行配对。",
      "pairs": { "カ": "ka", "キ": "ki", "ク": "ku", "ケ": "ke", "コ": "ko" }
    }
  ],
  "errorReasons": [
    {
      "id": "er.kata.ku.shape_ko",
      "knowledgePointId": "kp.kata.ku",
      "wrongChoice": "コ",
      "explainZh": "字形混了：コ 没有右侧斜捺；ク 的那一捺把「屋顶」撑开了。",
      "correctAudioKey": "audio.kata.ku",
      "confuseWith": "kp.kata.ko"
    },
    {
      "id": "er.kata.ko.shape_ku",
      "knowledgePointId": "kp.kata.ko",
      "wrongChoice": "ku",
      "explainZh": "コ 收得方正、两笔（横+竖钩）就是 ko；看到撑开的斜捺才念 ku。",
      "correctAudioKey": "audio.kata.ko",
      "confuseWith": "kp.kata.ku"
    }
  ]
}
