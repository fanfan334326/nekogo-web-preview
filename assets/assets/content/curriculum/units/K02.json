      "knowledgePointId": "kp.kata.ka",
      "promptZh": "把カ行的片假名和罗马音连起来。",
      "pairs": { "カ": "ka", "キ": "ki", "ク": "ku", "ケ": "ke", "コ": "ko" }
    }
  ],
  "quiz": [
