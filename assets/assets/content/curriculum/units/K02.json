{
  "schemaVersion": 1,
  "id": "K02",
  "stageId": "stage.katakana_seion",
  "order": 2,
  "title": "カ行",
  "titleZh": "片假名 カ行（カキクケコ）",
  "rowId": "ka",
  "knowledgePoints": [
    {
      "id": "kp.kata.ka",
      "kana": "カ",
      "romaji": "ka",
      "audioKey": "audio.kata.ka",
      "confusableIds": ["kp.kata.ke"],
      "tipZh": "片假名 カ 来自汉字「加」的左半：横折钩里加一撇，两笔写完。"
    },
    {
      "id": "kp.kata.ki",
      "kana": "キ",
      "romaji": "ki",
      "audioKey": "audio.kata.ki",
      "confusableIds": [],
      "tipZh": "片假名 キ 像汉字「木」少了撇捺：两横一竖一钩，竖要向下出头。"
    },
    {
      "id": "kp.kata.ku",
      "kana": "ク",
      "romaji": "ku",
      "audioKey": "audio.kata.ku",
      "confusableIds": ["kp.kata.ko"],
      "tipZh": "片假名 ク 是打开的「人」字头上缺一笔：横折加一捺，和平假名「く」几乎同形。"
    },
    {
      "id": "kp.kata.ke",
      "kana": "ケ",
      "romaji": "ke",
      "audioKey": "audio.kata.ke",
      "confusableIds": [],
      "tipZh": "片假名 ケ 就是汉字「又」少一点的样子：横撇加捺，两笔。"
    },
    {
      "id": "kp.kata.ko",
      "kana": "コ",
      "romaji": "ko",
      "audioKey": "audio.kata.ko",
      "confusableIds": ["kp.kata.ku"],
      "tipZh": "片假名 コ 两笔一横一竖钩，「咖啡」的「珈」右半；比 ク 少了斜捺。"
    }
  ],
  "teach": [
    {
      "id": "K02.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ka",
      "promptZh": "片假名 カ，罗马音 ka。",
      "audioKey": "audio.kata.ka",
      "noteZh": "カ 取自「加」：力字旁那一撇穿出就是カ。"
    },
    {
      "id": "K02.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.kata.ka",
      "promptZh": "点喇叭听 カ：清脆的「卡」。",
      "audioKey": "audio.kata.ka"
    },
    {
      "id": "K02.teach.3",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ki",
      "promptZh": "第二个：キ，罗马音 ki。",
      "audioKey": "audio.kata.ki",
      "noteZh": "キ 四笔：横、横、竖、提钩；上横短、下横长。"
    },
    {
      "id": "K02.teach.4",
      "type": "listen",
      "knowledgePointId": "kp.kata.ki",
      "promptZh": "听 キ：扁唇「衣」前加 k。",
      "audioKey": "audio.kata.ki"
    },
    {
      "id": "K02.teach.5",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ku",
      "promptZh": "第三个：ク，罗马音 ku。",
      "audioKey": "audio.kata.ku",
      "noteZh": "ク 与平假名 く 形近，都是张开的嘴形。"
    },
    {
      "id": "K02.teach.6",
      "type": "listen",
      "knowledgePointId": "kp.kata.ku",
      "promptZh": "听 ク：松唇的「乌」加 k。",
      "audioKey": "audio.kata.ku"
    },
    {
      "id": "K02.teach.7",
      "type": "compare",
      "knowledgePointId": "kp.kata.ku",
      "promptZh": "对比 ク / コ：ク 右边有一斜捺撑开；コ 只有横和竖钩，四面收得方。"
    },
    {
      "id": "K02.teach.8",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ke",
      "promptZh": "第四个：ケ，罗马音 ke。",
      "audioKey": "audio.kata.ke",
      "noteZh": "ケ 像「又」但第二笔不穿头；和「ア」的区别是ケ 两笔交叉。"
    },
    {
      "id": "K02.teach.9",
      "type": "listen",
      "knowledgePointId": "kp.kata.ke",
      "promptZh": "听 ケ：短促的「凯」。",
      "audioKey": "audio.kata.ke"
    },
    {
      "id": "K02.teach.10",
      "type": "introduce",
      "knowledgePointId": "kp.kata.ko",
      "promptZh": "第五个：コ，罗马音 ko。",
      "audioKey": "audio.kata.ko",
      "noteZh": "コ 来自「古」的上半：一横一竖钩收笔。"
    },
    {
      "id": "K02.teach.11",
      "type": "listen",
      "knowledgePointId": "kp.kata.ko",
      "promptZh": "听 コ：圆唇「阔」的前半。",
      "audioKey": "audio.kata.ko"
    },
    {
      "id": "K02.teach.12",
      "type": "stroke_hint",
      "knowledgePointId": "kp.kata.ka",
      "promptZh": "看笔顺：カ 一共 2 笔。",
      "noteZh": "① 横折钩一笔成形；② 中间那一撇从上方插入、穿过折钩。撇出头才算写对。"
    }
  ],
