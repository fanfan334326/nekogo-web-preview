      "type": "listen_choose",
      "knowledgePointId": "kp.kata.ke",
      "promptZh": "听一听，选出你听到的片假名（喇叭可以反复点）。",
      "audioKey": "audio.kata.ke",
      "choices": ["ケ", "カ", "キ", "ク"],
      "answer": "ケ"
    },
    {
      "id": "K02.practice.4",
