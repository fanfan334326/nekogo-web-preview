    {
      "id": "B02.teach.11",
      "type": "listen",
      "knowledgePointId": "kp.hira.zo",
      "promptZh": "点喇叭听 ぞ，跟着读 3 遍。",
      "audioKey": "audio.hira.zo"
    },
    {
      "id": "B02.teach.12",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.zu",
      "promptZh": "看笔顺：ず 是 す 的 2 笔加 2 点。",
      "noteZh": "先写横，再写竖下来绕小圈、向左下收的曲线；最后在右上加两点浊点。"
    }
