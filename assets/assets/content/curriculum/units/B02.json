  "teach": [
    {
      "id": "B02.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.hira.za",
      "promptZh": "浊音第二课：ざ，罗马音 za。",
      "audioKey": "audio.hira.za",
      "noteZh": "さ行整行加「゛」：さ→ざ、し→じ、す→ず、せ→ぜ、そ→ぞ。"
    },
    {
      "id": "B02.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.hira.za",
      "promptZh": "点喇叭听 ざ，跟着读 3 遍。",
      "audioKey": "audio.hira.za"
    },
    {
      "id": "B02.teach.3",
      "type": "introduce",
      "knowledgePointId": "kp.hira.ji",
      "promptZh": "第二个假名：じ，罗马音 ji。",
      "audioKey": "audio.hira.ji",
      "noteZh": "じ 是 し 右上加两点浊点，底字结构不变。"
    },
    {
      "id": "B02.teach.4",
      "type": "listen",
      "knowledgePointId": "kp.hira.ji",
      "promptZh": "点喇叭听 じ，跟着读 3 遍。",
      "audioKey": "audio.hira.ji"
    },
    {
      "id": "B02.teach.5",
      "type": "introduce",
      "knowledgePointId": "kp.hira.zu",
      "promptZh": "第三个假名：ず，罗马音 zu。",
      "audioKey": "audio.hira.zu",
      "noteZh": "ず 是 す 右上加两点浊点，底字结构不变。"
    },
    {
      "id": "B02.teach.6",
      "type": "listen",
      "knowledgePointId": "kp.hira.zu",
      "promptZh": "点喇叭听 ず，跟着读 3 遍。",
      "audioKey": "audio.hira.zu"
    },
    {
      "id": "B02.teach.7",
      "type": "compare",
      "knowledgePointId": "kp.hira.za",
      "promptZh": "对比 ざ / ず：ざ 的底字是 さ，下方弧线不绕圈；ず 的底字是 す，中部绕一个小圈。"
    },
    {
      "id": "B02.teach.8",
      "type": "introduce",
      "knowledgePointId": "kp.hira.ze",
      "promptZh": "第四个假名：ぜ，罗马音 ze。",
