      "choices": ["きょ", "きゅ", "きよ", "か"],
      "answer": "きょ"
    },
    {
      "id": "C01.practice.4",
      "type": "match",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "把きゃ行的假名和罗马音连起来。",
      "pairs": { "きゃ": "kya", "きゅ": "kyu", "きょ": "kyo" }
    }
  ],
  "quiz": [
