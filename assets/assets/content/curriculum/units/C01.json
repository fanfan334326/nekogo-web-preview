  "errorReasons": [
    {
      "id": "er.hira.kya.sound_kiya",
      "knowledgePointId": "kp.hira.kya",
      "wrongChoice": "kiya",
      "explainZh": "拗音只有一拍：kya 连读，不能拆成 ki-ya 两拍；kiya 那种写法对应「木屋」这类两词叠加。",
      "correctAudioKey": "audio.hira.kya"
    },
    {
      "id": "er.hira.kyu.shape_kyo",
      "knowledgePointId": "kp.hira.kyu",
      "wrongChoice": "きょ",
      "explainZh": "小字混了：小 ゆ 底下是交叉两笔，小 よ 是一横一竖圈；kyu 圆唇收得更快。",
      "correctAudioKey": "audio.hira.kyu",
      "confuseWith": "kp.hira.kyo"
    }
  ]
