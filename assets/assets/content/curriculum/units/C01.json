{
  "schemaVersion": 1,
  "id": "C01",
  "stageId": "stage.hiragana_youon",
  "order": 1,
  "title": "きゃ行",
  "titleZh": "平假名拗音 きゃ行（大 き + 小 や/ゆ/よ）",
  "rowId": "kya",
  "knowledgePoints": [
    {
      "id": "kp.hira.kya",
      "kana": "きゃ",
      "romaji": "kya",
      "audioKey": "audio.hira.kya",
      "confusableIds": ["kp.hira.kyo"],
      "tipZh": "大「き」+ 小「や」拼成一个音节 kya；小 や 只占半格、不能单独拖一拍。"
    },
    {
      "id": "kp.hira.kyu",
      "kana": "きゅ",
      "romaji": "kyu",
      "audioKey": "audio.hira.kyu",
      "confusableIds": [],
      "tipZh": "大「き」+ 小「ゆ」读 kyu，一步到位圆唇，别读成「き-ゆ」两拍。"
    },
    {
      "id": "kp.hira.kyo",
      "kana": "きょ",
      "romaji": "kyo",
      "audioKey": "audio.hira.kyo",
      "confusableIds": [],
      "tipZh": "大「き」+ 小「よ」读 kyo；注意小「よ」不是小「ゆ」，圈笔开口更大。"
    }
  ],
  "teach": [
    {
      "id": "C01.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "拗音第一课：きゃ，罗马音 kya，一拍读完。",
      "audioKey": "audio.hira.kya",
      "noteZh": "拗音 = い 段假名（这里是大 き）+ 小 や/ゆ/よ，两个字合成一个新音节，占一格不占两格。"
    },
    {
      "id": "C01.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "点喇叭听 きゃ：k 后面直接滑到 ya，一气呵成。",
      "audioKey": "audio.hira.kya"
    },
    {
      "id": "C01.teach.3",
      "type": "introduce",
      "knowledgePointId": "kp.hira.kyu",
      "promptZh": "第二个：きゅ，罗马音 kyu。",
      "audioKey": "audio.hira.kyu",
      "noteZh": "小 ゆ 写得比大 き 矮一半，位置贴着き 的右下方。"
    },
    {
      "id": "C01.teach.4",
      "type": "listen",
      "knowledgePointId": "kp.hira.kyu",
      "promptZh": "听 きゅ：像中文「求」但前面带 k 的弹开。",
      "audioKey": "audio.hira.kyu"
    },
    {
      "id": "C01.teach.5",
      "type": "compare",
      "knowledgePointId": "kp.hira.kyu",
      "promptZh": "对比小 ゆ / 小 よ：ゆ 下面是两笔交叉的钩，よ 是一个横加一个竖圈。"
    },
    {
      "id": "C01.teach.6",
      "type": "introduce",
      "knowledgePointId": "kp.hira.kyo",
      "promptZh": "第三个：きょ，罗马音 kyo。",
      "audioKey": "audio.hira.kyo",
      "noteZh": "大 き + 小 よ，「今日」きょう 就用它。"
    },
    {
      "id": "C01.teach.7",
      "type": "listen",
      "knowledgePointId": "kp.hira.kyo",
      "promptZh": "听 きょ：圆唇的 o，别听成扁平的 kyu。",
      "audioKey": "audio.hira.kyo"
    },
    {
      "id": "C01.teach.8",
      "type": "compare",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "对比 きゃ / き・や：きゃ 一拍连读；「木屋」き・や 才有中点隔开的两拍。"
    },
    {
      "id": "C01.teach.9",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "看布局：きゃ = 大字 + 小字同格。",
      "noteZh": "先写完整的 き（3 笔），再在右下写半个高度的 や（3 笔）；小字不越格线。"
    }
  ],
