  "title": "きゃ行",
  "titleZh": "平假名拗音 きゃ行（大 き + 小 や/ゆ/よ）",
  "rowId": "kya",
  "knowledgePoints": [
    {
      "id": "kp.hira.kya",
      "kana": "きゃ",
      "romaji": "kya",
      "audioKey": "audio.hira.kya",
      "confusableIds": ["kp.hira.kyo"],
      "tipZh": "き 加小 ゃ，两个字合起来读 kya，占一拍；不要拆成 き・や 两拍。"
    },
    {
      "id": "kp.hira.kyu",
      "kana": "きゅ",
      "romaji": "kyu",
      "audioKey": "audio.hira.kyu",
      "confusableIds": [],
      "tipZh": "き 加小 ゅ，两个字合起来读 kyu，占一拍；不要拆成 き・ゆ 两拍。"
    },
    {
      "id": "kp.hira.kyo",
      "kana": "きょ",
      "romaji": "kyo",
      "audioKey": "audio.hira.kyo",
      "confusableIds": [],
      "tipZh": "き 加小 ょ，两个字合起来读 kyo，占一拍；注意小字是 ょ，不是 ゅ。"
    }
  ],
  "teach": [
    {
      "id": "C01.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "拗音第一课：きゃ，罗马音 kya，一拍读完。",
      "audioKey": "audio.hira.kya",
      "noteZh": "本课学习 き 加小 ゃ／ゅ／ょ 的拗音。两个假名合读一拍，拍数不等于书写字数。"
    },
    {
      "id": "C01.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "点喇叭听 きゃ：k 后面直接滑到 ya，一气呵成。",
      "audioKey": "audio.hira.kya"
    },
    {
      "id": "C01.teach.3",
      "type": "introduce",
      "knowledgePointId": "kp.hira.kyu",
      "promptZh": "第二个：きゅ，罗马音 kyu。",
      "audioKey": "audio.hira.kyu",
      "noteZh": "ゅ 写得比 き 小，接在 き 后面；不要写成大字 ゆ。"
    },
    {
      "id": "C01.teach.4",
      "type": "listen",
      "knowledgePointId": "kp.hira.kyu",
      "promptZh": "点喇叭听 きゅ，一拍读完，不要读成 き・ゆ 两拍。",
      "audioKey": "audio.hira.kyu"
    },
    {
      "id": "C01.teach.5",
      "type": "compare",
      "knowledgePointId": "kp.hira.kyu",
      "promptZh": "对比小 ゅ / 小 ょ：ゅ 右侧有穿过曲线的竖笔；ょ 右上有短横，下方绕一个小圈。"
    },
    {
      "id": "C01.teach.6",
      "type": "introduce",
      "knowledgePointId": "kp.hira.kyo",
      "promptZh": "第三个：きょ，罗马音 kyo。",
      "audioKey": "audio.hira.kyo",
      "noteZh": "大 き + 小 よ，「今日」きょう 就用它。"
    },
    {
      "id": "C01.teach.7",
      "type": "listen",
      "knowledgePointId": "kp.hira.kyo",
      "promptZh": "点喇叭听 きょ，再与 きゅ 比较，留意末尾元音的区别。",
      "audioKey": "audio.hira.kyo"
    },
    {
      "id": "C01.teach.8",
      "type": "compare",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "对比 きゃ / きや：きゃ 中的 ゃ 小写，合读一拍；きや 中的 や 大写，读两拍。"
    },
    {
      "id": "C01.teach.9",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.kya",
      "promptZh": "看布局：きゃ = 正常大小的 き + 小字 ゃ。",
      "noteZh": "手写时先写 き 的四笔，再写小 ゃ 的三笔。小字保持 や 的结构；合读一拍不等于把两字塞进同一格。"
    }
  ],
