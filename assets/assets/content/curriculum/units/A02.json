      "romaji": "ke",
      "audioKey": "audio.hira.ke",
      "confusableIds": [
        "kp.hira.wa"
      ],
      "tipZh": "け 左侧一笔，右侧一横一竖；右侧不绕圈。"
    },
    {
      "id": "kp.hira.ko",
      "kana": "こ",
      "romaji": "ko",
      "audioKey": "audio.hira.ko",
      "confusableIds": [],
      "tipZh": "こ 有两笔，上下分开；上笔短，下笔向右舒展。"
    }
  ],
