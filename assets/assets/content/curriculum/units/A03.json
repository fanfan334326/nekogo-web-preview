  "titleZh": "平假名 さ行（s 音）",
  "rowId": "sa",
  "knowledgePoints": [
    {
      "id": "kp.hira.sa",
      "kana": "さ",
      "romaji": "sa",
      "audioKey": "audio.hira.sa",
      "confusableIds": [
        "kp.hira.ne"
      ],
      "tipZh": "さ 上方一横与斜笔相交，下方有弧线；手写时下方通常断开，没有右下小圈。"
    },
    {
      "id": "kp.hira.shi",
      "kana": "し",
      "romaji": "shi",
      "audioKey": "audio.hira.shi",
      "confusableIds": [
        "kp.hira.tsu"
      ],
      "tipZh": "し 一笔从上向下弯，再向右上收；整体纵向展开。"
    },
    {
      "id": "kp.hira.su",
      "kana": "す",
      "romaji": "su",
      "audioKey": "audio.hira.su",
      "confusableIds": [],
      "tipZh": "す 有两笔：横，竖下来绕小圈再向左下收；小圈与竖相连。"
    },
    {
      "id": "kp.hira.se",
      "kana": "せ",
      "romaji": "se",
      "audioKey": "audio.hira.se",
      "confusableIds": [],
      "tipZh": "せ 有三笔：横、右侧短竖、左侧向下再右转的竖弯。"
    },
    {
      "id": "kp.hira.so",
      "kana": "そ",
      "romaji": "so",
      "audioKey": "audio.hira.so",
      "confusableIds": [],
      "tipZh": "そ 上方折转后连到下方弧线；常见一笔写法，也有上方分开写的字形。"
    }
  ],
