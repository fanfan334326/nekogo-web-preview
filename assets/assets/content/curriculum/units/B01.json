  "teach": [
    {
      "id": "B01.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.hira.ga",
      "promptZh": "浊音第一课：が，罗马音 ga。",
      "audioKey": "audio.hira.ga",
      "noteZh": "浊音就是在清音右上角加两点「゛」（浊点），か→が、き→ぎ、く→ぐ、け→げ、こ→ご。"
    },
    {
      "id": "B01.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.hira.ga",
      "promptZh": "点喇叭听 が，跟着读 3 遍。",
      "audioKey": "audio.hira.ga"
    },
