  "errorReasons": [
    {
      "id": "er.kata.o.shape_a",
      "knowledgePointId": "kp.kata.o",
      "wrongChoice": "a",
      "explainZh": "字形混了：ア 末笔是直的长撇；オ 第三笔带竖钩、且上面是两横。数笔画最可靠。",
      "correctAudioKey": "audio.kata.o",
      "confuseWith": "kp.kata.a"
    },
    {
      "id": "er.kata.a.shape_o",
      "knowledgePointId": "kp.kata.a",
      "wrongChoice": "オ",
      "explainZh": "两笔的是 ア；オ 有三笔、最后一笔带钩。看到「横横撇钩」就选 o。",
      "correctAudioKey": "audio.kata.a",
      "confuseWith": "kp.kata.o"
    }
  ]
}
