  "errorReasons": [
    {
      "id": "er.kata.chi.shape_tsu",
      "knowledgePointId": "kp.kata.chi",
      "wrongChoice": "ツ",
      "explainZh": "字形混了：チ 的弯钩一笔到底；ツ 是横加两点再撇。看「有没有翅膀点」。",
      "correctAudioKey": "audio.kata.chi",
      "confuseWith": "kp.kata.tsu"
    },
    {
      "id": "er.kata.tsu.sound_su",
      "knowledgePointId": "kp.kata.tsu",
      "wrongChoice": "su",
      "explainZh": "听混了：tsu 前面有清晰的 t 塞音（刺），su 只有齿缝气流（斯）。再点一次喇叭对比。",
      "correctAudioKey": "audio.kata.tsu"
    }
  ]
