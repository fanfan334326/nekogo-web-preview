  "knowledgePoints": [
    {
      "id": "kp.hira.ha",
      "kana": "は",
      "romaji": "ha",
      "audioKey": "audio.hira.ha",
      "confusableIds": [],
      "tipZh": "は 有三笔，左侧独立一笔，右侧一横与带小圈的竖弯相连。"
    },
    {
      "id": "kp.hira.hi",
      "kana": "ひ",
      "romaji": "hi",
      "audioKey": "audio.hira.hi",
      "confusableIds": [],
      "tipZh": "ひ 一笔写成，下方呈圆弧，两侧向上展开；中间没有小圈。"
    },
    {
      "id": "kp.hira.fu",
      "kana": "ふ",
      "romaji": "fu",
      "audioKey": "audio.hira.fu",
      "confusableIds": [
        "kp.hira.tsu"
      ],
      "tipZh": "ふ 有四笔：上方短点、中间曲线、左下点、右下点；没有半浊点的小圈。"
    },
    {
      "id": "kp.hira.he",
      "kana": "へ",
      "romaji": "he",
      "audioKey": "audio.hira.he",
      "confusableIds": [
        "kp.hira.wo"
      ],
      "tipZh": "へ 一笔折成山形，先向右上，再向右下落；不带钩。"
    },
    {
      "id": "kp.hira.ho",
      "kana": "ほ",
      "romaji": "ho",
      "audioKey": "audio.hira.ho",
      "confusableIds": [],
      "tipZh": "ほ 左侧独立一笔，右侧两横加带小圈的竖弯；比 は 的右侧多一横。"
    }
  ],
