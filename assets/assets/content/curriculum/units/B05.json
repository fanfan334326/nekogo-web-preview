      "knowledgePointId": "kp.hira.pu",
      "promptZh": "独立测验：把 ぱ 行假名和罗马音配成对。",
      "pairs": { "ぱ": "pa", "ぴ": "pi", "ぷ": "pu", "ぺ": "pe", "ぽ": "po" }
    }
  ],
  "errorReasons": [
    {
      "id": "er.hira.pu.shape_bu",
      "knowledgePointId": "kp.hira.pu",
      "wrongChoice": "ぶ",
      "explainZh": "标记看反了：右上两点「゛」是浊音 ぶ，一个小圈「ﾟ」才是半浊音 ぷ。",
      "correctAudioKey": "audio.hira.pu",
      "confuseWith": "kp.hira.bu"
    },
    {
      "id": "er.hira.pi.sound_bi",
      "knowledgePointId": "kp.hira.pi",
      "wrongChoice": "び",
      "explainZh": "听混了：び 震喉是 b 音，ぴ 不震喉是 p 音；再点一次喇叭对比。",
      "correctAudioKey": "audio.hira.pi",
      "confuseWith": "kp.hira.bi"
    },
    {
      "id": "er.hira.pa.shape_ba",
      "knowledgePointId": "kp.hira.pa",
      "wrongChoice": "ba",
      "explainZh": "ぱ 头上是一个圈（半浊音）读 pa；两点才是 ば。书写时圈要画小、写在右上。",
      "correctAudioKey": "audio.hira.pa",
      "confuseWith": "kp.hira.ba"
    }
  ]
}
