      "type": "listen_choose",
      "knowledgePointId": "kp.hira.pi",
      "promptZh": "听一听，选出你听到的假名（喇叭可以反复点）。",
      "audioKey": "audio.hira.pi",
      "choices": ["ぴ", "び", "ひ", "み"],
      "answer": "ぴ",
      "errorReasonId": "er.hira.pi.sound_bi"
    },
    {
      "id": "B05.practice.4",
      "type": "choose_romaji",
      "knowledgePointId": "kp.hira.po",
      "promptZh": "「ぽ」的罗马音是？",
      "stem": "ぽ",
      "choices": ["po", "bo", "ho", "no"],
      "answer": "po"
    },
    {
      "id": "B05.practice.5",
      "type": "match",
      "knowledgePointId": "kp.hira.pa",
      "promptZh": "把 ぱ 行的假名和罗马音连起来。",
      "pairs": { "ぱ": "pa", "ぴ": "pi", "ぷ": "pu", "ぺ": "pe", "ぽ": "po" }
    }
  ],
  "quiz": [
    {
      "id": "B05.quiz.1",
      "type": "choose_kana",
      "knowledgePointId": "kp.hira.pe",
      "promptZh": "罗马音 pe 对应哪个假名？",
      "stem": "pe",
      "choices": ["ぺ", "べ", "へ", "め"],
      "answer": "ぺ"
    },
    {
      "id": "B05.quiz.2",
      "type": "choose_romaji",
      "knowledgePointId": "kp.hira.pa",
      "promptZh": "「ぱ」的罗马音是？",
      "stem": "ぱ",
      "choices": ["pa", "ba", "pi", "pu"],
      "answer": "pa",
      "errorReasonId": "er.hira.pa.shape_ba"
    },
    {
      "id": "B05.quiz.3",
      "type": "listen_choose",
      "knowledgePointId": "kp.hira.po",
      "promptZh": "听音，选出你听到的罗马音。",
      "audioKey": "audio.hira.po",
      "choices": ["po", "bo", "ho", "mo"],
      "answer": "po"
    },
    {
      "id": "B05.quiz.4",
      "type": "choose_kana",
      "knowledgePointId": "kp.hira.pi",
      "promptZh": "罗马音 pi 对应哪个假名？",
      "stem": "pi",
      "choices": ["ぴ", "び", "ひ", "に"],
      "answer": "ぴ"
    },
    {
      "id": "B05.quiz.5",
