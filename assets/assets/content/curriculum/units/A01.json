      "pairs": { "あ": "a", "い": "i", "う": "u", "え": "e", "お": "o" }
    }
  ],
  "errorReasons": [
    {
      "id": "er.hira.a.sound_o",
      "knowledgePointId": "kp.hira.a",
      "wrongChoice": "o",
      "explainZh": "把 あ 读成了 お：あ 嘴张到底、只有一个音；お 是圆唇，而且只写一次口形。再点一次喇叭对比听。",
      "correctAudioKey": "audio.hira.a",
      "confuseWith": "kp.hira.o"
    },
    {
      "id": "er.hira.a.shape_o",
      "knowledgePointId": "kp.hira.a",
      "wrongChoice": "お",
      "explainZh": "字形混了：あ 的圈把竖笔下端包在里面；お 的圈在竖笔右侧、竖笔向下出头。",
      "correctAudioKey": "audio.hira.a",
      "confuseWith": "kp.hira.o"
    },
    {
      "id": "er.hira.e.sound_a",
      "knowledgePointId": "kp.hira.e",
      "wrongChoice": "a",
      "explainZh": "听成 あ 了：え 嘴角向两侧拉（像「诶」），开口比 あ 小。",
      "correctAudioKey": "audio.hira.e",
      "confuseWith": "kp.hira.a"
    },
    {
      "id": "er.hira.e.shape_o",
      "knowledgePointId": "kp.hira.e",
      "wrongChoice": "お",
      "explainZh": "字形混了：え 中间多一横、下面连两个圈；お 只有一竖加右下一个圈。",
      "correctAudioKey": "audio.hira.e",
      "confuseWith": "kp.hira.o"
    },
    {
      "id": "er.hira.u.shape_nu",
      "knowledgePointId": "kp.hira.u",
      "wrongChoice": "ぬ",
      "explainZh": "う 只有 2 笔、横折上端是开口的；ぬ 右边那一竖穿过圈。这是か行的邻居字，先记住う 没有竖。",
      "correctAudioKey": "audio.hira.u",
      "confuseWith": "kp.hira.nu"
    },
    {
      "id": "er.hira.o.shape_no",
      "knowledgePointId": "kp.hira.o",
      "wrongChoice": "の",
      "explainZh": "お 的圈小、在右下，竖笔向下出头；の 是一整笔绕上去的大圈、竖笔不出头。",
      "correctAudioKey": "audio.hira.o",
      "confuseWith": "kp.hira.no"
    },
    {
      "id": "er.hira.o.sound_e",
      "knowledgePointId": "kp.hira.o",
      "wrongChoice": "e",
      "explainZh": "お 是圆唇、一次到位；え 是扁唇。听的时候盯住嘴唇圆不圆。",
      "correctAudioKey": "audio.hira.o",
      "confuseWith": "kp.hira.e"
    }
  ]
}
