{
  "schemaVersion": 1,
  "id": "A01",
  "stageId": "stage.hiragana_seion",
  "order": 1,
  "title": "あ行",
  "titleZh": "平假名 あ行（5 个元音）",
  "rowId": "a",
  "knowledgePoints": [
    {
      "id": "kp.hira.a",
      "kana": "あ",
      "romaji": "a",
      "audioKey": "audio.hira.a",
      "confusableIds": ["kp.hira.o"],
      "tipZh": "あ 有三笔：横、竖弯、绕回的曲线；中部有交叉，别和 お 混淆。"
    },
    {
      "id": "kp.hira.i",
      "kana": "い",
      "romaji": "i",
      "audioKey": "audio.hira.i",
      "confusableIds": [],
      "tipZh": "い 有两笔，左右分开；左笔较长、末端轻挑，右笔较短。"
    },
    {
      "id": "kp.hira.u",
      "kana": "う",
      "romaji": "u",
      "audioKey": "audio.hira.u",
      "confusableIds": ["kp.hira.nu"],
      "tipZh": "う 有两笔：上方短点，下面的曲线先向右，再向左下收。"
    },
    {
      "id": "kp.hira.e",
      "kana": "え",
      "romaji": "e",
      "audioKey": "audio.hira.e",
      "confusableIds": ["kp.hira.a", "kp.hira.o"],
      "tipZh": "え 有两笔：上方短点，下面一笔折向左下再向右舒展；没有圈。"
    },
    {
      "id": "kp.hira.o",
      "kana": "お",
      "romaji": "o",
      "audioKey": "audio.hira.o",
      "confusableIds": ["kp.hira.e", "kp.hira.no"],
      "tipZh": "お 有三笔：横、带小圈的竖弯、右上短点；注意右上那一点。"
    }
  ],
  "teach": [
    {
      "id": "A01.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "第一个假名：あ，罗马音 a。",
      "audioKey": "audio.hira.a",
      "noteZh": "あ行的 5 个假名就是日语的 5 个元音，后面所有行都要靠它们拼读。"
    },
    {
      "id": "A01.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "点喇叭听 あ，跟着读 3 遍。",
      "audioKey": "audio.hira.a"
    },
    {
      "id": "A01.teach.3",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "看笔顺：あ 一共 3 笔。",
      "noteZh": "① 横；② 从横上方起笔向下略弯；③ 从右上向左下穿过竖，再绕向右侧收笔。"
    },
    {
      "id": "A01.teach.4",
      "type": "introduce",
      "knowledgePointId": "kp.hira.i",
      "promptZh": "第二个假名：い，罗马音 i。",
      "audioKey": "audio.hira.i",
      "noteZh": "い 有两笔，左右分开；左笔较长、末端轻挑，右笔较短。"
    },
    {
      "id": "A01.teach.5",
      "type": "listen",
      "knowledgePointId": "kp.hira.i",
      "promptZh": "点喇叭听 い，跟着读 3 遍。",
      "audioKey": "audio.hira.i"
    },
    {
      "id": "A01.teach.6",
      "type": "introduce",
      "knowledgePointId": "kp.hira.u",
      "promptZh": "第三个假名：う，罗马音 u。",
      "audioKey": "audio.hira.u",
      "noteZh": "う 有两笔：上方短点，下面的曲线先向右，再向左下收。"
    },
    {
      "id": "A01.teach.7",
      "type": "listen",
      "knowledgePointId": "kp.hira.u",
      "promptZh": "点喇叭听 う，跟着读 3 遍。",
      "audioKey": "audio.hira.u"
    },
    {
      "id": "A01.teach.8",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.u",
      "promptZh": "看笔顺：う 一共 2 笔。",
      "noteZh": "① 上方短点；② 从左向右起笔，再向下弯、向左下收。不要写成方形横折钩。"
    },
    {
      "id": "A01.teach.9",
      "type": "introduce",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "第四个假名：え，罗马音 e。",
      "audioKey": "audio.hira.e",
      "noteZh": "え 有两笔：上方短点，下面一笔折向左下再向右舒展；没有圈。"
    },
    {
      "id": "A01.teach.10",
      "type": "listen",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "点喇叭听 え，跟着读 3 遍。",
      "audioKey": "audio.hira.e"
    },
    {
      "id": "A01.teach.11",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "看笔顺：え 一共 2 笔。",
      "noteZh": "① 上方短点；② 横向右、折向左下，再向右弯出收笔；没有圈，也没有独立竖笔。"
    },
    {
      "id": "A01.teach.12",
      "type": "introduce",
      "knowledgePointId": "kp.hira.o",
      "promptZh": "第五个假名：お，罗马音 o。",
      "audioKey": "audio.hira.o",
      "noteZh": "お 有三笔：横、带小圈的竖弯、右上短点；注意右上那一点。"
    },
    {
      "id": "A01.teach.13",
      "type": "listen",
      "knowledgePointId": "kp.hira.o",
      "promptZh": "点喇叭听 お，跟着读 3 遍。",
      "audioKey": "audio.hira.o"
    },
    {
      "id": "A01.teach.14",
      "type": "compare",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "对比 え / お：え 上方有短点、下方没有圈；お 右上有短点、下方有小圈。"
    },
    {
      "id": "A01.teach.15",
      "type": "compare",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "对比 あ / お：あ 中部有交叉，お 右上有独立短点；留意交叉和短点的位置。"
    }
  ],
