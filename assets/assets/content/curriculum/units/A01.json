{
  "schemaVersion": 1,
  "id": "A01",
  "stageId": "stage.hiragana_seion",
  "order": 1,
  "title": "あ行",
  "titleZh": "平假名 あ行（5 个元音）",
  "rowId": "a",
  "knowledgePoints": [
    {
      "id": "kp.hira.a",
      "kana": "あ",
      "romaji": "a",
      "audioKey": "audio.hira.a",
      "confusableIds": ["kp.hira.o"],
      "tipZh": "来自汉字「安」的草写。读时嘴张到最大，像体检时发的「啊——」。"
    },
    {
      "id": "kp.hira.i",
      "kana": "い",
      "romaji": "i",
      "audioKey": "audio.hira.i",
      "confusableIds": [],
      "tipZh": "来自「以」的草写，两笔竖提。发音时嘴角用力向两边拉，是扁唇音。"
    },
    {
      "id": "kp.hira.u",
      "kana": "う",
      "romaji": "u",
      "audioKey": "audio.hira.u",
      "confusableIds": ["kp.hira.nu"],
      "tipZh": "来自「宇」的草写：上面一点，下面一个方方的横折。嘴唇轻轻前突，不要撅成圆形的「乌」。"
    },
    {
      "id": "kp.hira.e",
      "kana": "え",
      "romaji": "e",
      "audioKey": "audio.hira.e",
      "confusableIds": ["kp.hira.a", "kp.hira.o"],
      "tipZh": "来自「衣」的草写，中间一竖要出头。发音接近中文「诶」。"
    },
    {
      "id": "kp.hira.o",
      "kana": "お",
      "romaji": "o",
      "audioKey": "audio.hira.o",
      "confusableIds": ["kp.hira.e", "kp.hira.no"],
      "tipZh": "来自「我」的草写，圈写在右下、不穿过竖笔。发音是圆唇的「哦」，一次到位、不收成两段。"
    }
  ],
  "teach": [
    {
      "id": "A01.teach.1",
      "type": "introduce",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "第一个假名：あ，罗马音 a。",
      "audioKey": "audio.hira.a",
      "noteZh": "あ行的 5 个假名就是日语的 5 个元音，后面所有行都要靠它们拼读。"
    },
    {
      "id": "A01.teach.2",
      "type": "listen",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "点喇叭听 あ，跟着读 3 遍，注意开口度要最大。",
      "audioKey": "audio.hira.a"
    },
    {
      "id": "A01.teach.3",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "看笔顺：あ 一共 3 笔。",
      "noteZh": "① 横；② 一竖从横的中部往下，略微向左弯；③ 从右上起笔，绕一个把竖笔下端包在里面的圈。"
    },
    {
      "id": "A01.teach.4",
      "type": "introduce",
      "knowledgePointId": "kp.hira.i",
      "promptZh": "第二个假名：い，罗马音 i。",
      "audioKey": "audio.hira.i",
      "noteZh": "两笔竖提，左边短、右边长。"
    },
    {
      "id": "A01.teach.5",
      "type": "listen",
      "knowledgePointId": "kp.hira.i",
      "promptZh": "听 い：嘴角向两边拉，短促清楚。",
      "audioKey": "audio.hira.i"
    },
    {
      "id": "A01.teach.6",
      "type": "introduce",
      "knowledgePointId": "kp.hira.u",
      "promptZh": "第三个假名：う，罗马音 u。",
      "audioKey": "audio.hira.u",
      "noteZh": "和中文「乌」不同：日语う嘴唇几乎不圆，只是一点点前突。"
    },
    {
      "id": "A01.teach.7",
      "type": "listen",
      "knowledgePointId": "kp.hira.u",
      "promptZh": "听 う，和 あ 对比：开口明显变小。",
      "audioKey": "audio.hira.u"
    },
    {
      "id": "A01.teach.8",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.u",
      "promptZh": "看笔顺：う 一共 2 笔。",
      "noteZh": "① 上面一个短点（略向左下的短撇）；② 横折——横写完后折下去，再向右上挑出收笔。"
    },
    {
      "id": "A01.teach.9",
      "type": "introduce",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "第四个假名：え，罗马音 e。",
      "audioKey": "audio.hira.e",
      "noteZh": "中间那一竖要出头，这是它和 お 最直观的差别。"
    },
    {
      "id": "A01.teach.10",
      "type": "listen",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "听 え：接近中文「诶」。",
      "audioKey": "audio.hira.e"
    },
    {
      "id": "A01.teach.11",
      "type": "stroke_hint",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "写え的笔顺。",
      "noteZh": "先写横，再写穿过它并向上出头的一竖，最后从竖的底端连出一个向右的圈。"
    },
    {
      "id": "A01.teach.12",
      "type": "introduce",
      "knowledgePointId": "kp.hira.o",
      "promptZh": "第五个假名：お，罗马音 o。",
      "audioKey": "audio.hira.o",
      "noteZh": "发音是圆唇的「哦」，一次到位，不要滑成「欧」。"
    },
    {
      "id": "A01.teach.13",
      "type": "listen",
      "knowledgePointId": "kp.hira.o",
      "promptZh": "听 お，再和 え 连着听一遍。",
      "audioKey": "audio.hira.o"
    },
    {
      "id": "A01.teach.14",
      "type": "compare",
      "knowledgePointId": "kp.hira.e",
      "promptZh": "对比 え / お：え 中间多一横、下面有两个圈；お 只有一竖加右下一个圈。"
    },
    {
      "id": "A01.teach.15",
      "type": "compare",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "对比 あ / お：あ 的圈把竖笔下端包在里面；お 的圈在竖笔右侧、竖笔向下出头。"
    }
  ],
  "practice": [
    {
