    },
    {
      "id": "A01.practice.5",
      "type": "choose_kana",
      "knowledgePointId": "kp.hira.i",
      "promptZh": "罗马音 i 对应哪个假名？",
      "stem": "i",
      "choices": ["い", "む", "め", "り"],
      "answer": "い"
    },
    {
      "id": "A01.practice.6",
      "type": "match",
      "knowledgePointId": "kp.hira.a",
      "promptZh": "把 あ 行的假名和罗马音连起来。",
      "pairs": { "あ": "a", "い": "i", "う": "u", "え": "e", "お": "o" }
    }
  ],
